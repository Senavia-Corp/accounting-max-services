---
import "../styles/main.css";
import { t } from "../lib/i18n";
import { otroIdioma } from "../lib/es";
// El nombre del negocio es NAP y va literal en las dos lenguas (ver i18n.ts:17).
import { NEGOCIO } from "../lib/sanity";
import WhatsAppWidget from "../components/WhatsAppWidget.astro";

interface Props {
  title: string;
  description?: string;
  /**
   * D4: solo /privacy-policy y /terms. Son borradores de aviso GLBA a la espera
   * de abogado. Las 26 rutas /es dejaron de usarla al firmarse D3 (2026-07-31).
   */
  noindex?: boolean;
  lang?: "en" | "es";
  /** Imagen de la tarjeta al compartir. Absoluta o de raiz; cae a /og-default.png. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
}

const {
  title, description, noindex = false, lang = "en",
  ogImage, ogImageAlt, ogType = "website",
} = Astro.props;

// Canonical absoluto. En produccion hoy no hay ni un solo rel=canonical en
// ninguna de las 26 rutas, y el staging .webflow.io es un duplicado completo.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// hreflang reciproco (D3, firmado 2026-07-31). Va aqui y no en las plantillas
// porque este layout envuelve las 54 rutas: una sola definicion, imposible que
// una pagina se quede sin su etiqueta de retorno.
//
// `otro` es null en /privacy-policy y /terms, que no tienen gemela espanola
// (D4). Ahi no se emite NADA: una alternativa sin retorno es justo el error que
// Search Console reporta como «alternativa sin etiqueta de retorno».
//
// Las dos URLs del par salen del mismo `new URL(..., site)` en las dos
// direcciones — el propio canonical de un lado y `otroIdioma()` del otro — asi
// que la pagina EN y su gemela ES emiten el par identico. Eso ES la
// reciprocidad: no hay que confiar en ella, se comprueba sobre dist.
const otro = otroIdioma(Astro.url.pathname);
const hrefOtro = otro ? new URL(otro.href, Astro.site).href : "";
const hrefEn = otro?.lang === "en" ? hrefOtro : canonical;
const hrefEs = otro?.lang === "es" ? hrefOtro : canonical;

// Open Graph. Antes de esto, NINGUNA de las 54 rutas emitia og:image: compartir
// cualquier pagina en WhatsApp o LinkedIn daba una tarjeta sin imagen.
//
// POR QUE NO SE COMPONE UNA IMAGEN POR RUTA: 44 de las 54 rutas ya tienen una
// imagen real y propia — su foto de servicio o la portada del post — asi que la
// tarjeta sale distinta sin fabricar nada. Y rotular el titulo DENTRO del PNG
// seria un error doble: las 20 rutas /es reutilizan el mismo asset y quedarian
// con el titulo en ingles incrustado, y rasterizar texto exige una fuente que
// aqui no hay (las 6 Campton son comerciales y con licencia pendiente, D2).
// og:title ya lleva el titular y los scrapers lo pintan junto a la imagen.
//
// Las 10 rutas sin imagen propia caen a /og-default.png, que ya existia y que
// JsonLd.astro ya usaba como `image` del negocio.
//
// `new URL(x, site)` sirve para los dos casos sin ramificar: deja intacta la
// URL absoluta del CDN de Sanity y hace absoluta la ruta de raiz. Una relativa
// no la resuelve ningun scraper.
const OG_ANCHO = 1200;
const OG_ALTO = 630;
const og = new URL(ogImage || "/og-default.png", Astro.site).href;
const ogAlt = ogImageAlt || `${NEGOCIO.nombre} logo`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      MEDICION. Contenedor de Google Tag Manager, el unico rastreador del sitio.

      La propiedad GA4 (G-L521MPS8H9) se configura DENTRO de GTM y no aparece en
      este repositorio. El snippet de gtag.js que Google entrega junto a ese ID
      NO se instala: con los dos a la vez cada una de las 54 rutas emitiria dos
      page_view — uno por gtag.js y otro por el GA4 de GTM — y toda metrica de
      sesion y de conversion saldria inflada. tools/gtm-check.mjs lo vigila para
      que una sesion futura no lo pegue «porque Google lo dio».

      `is:inline` es OBLIGATORIO. Un <script> normal de Astro sale como
      type="module" en el <body> (ver la nota de mas abajo en este mismo head),
      o sea diferido y DESPUES de los scripts de los formularios: el dataLayer
      no existiria en el instante en que contact-us y FooterSubscribe empujan su
      conversion.

      El ID va literal y no en una PUBLIC_GTM_ID. Es publico —se lee en el HTML
      de las 54 rutas— y las variables PUBLIC_ las hornea Vite en tiempo de
      build, que es justo la clase de fallo que costo una sesion entera con la
      site key de Turnstile.

      page_language se empuja ANTES del contenedor, para que GTM lo tenga desde
      el primer evento y no a partir del segundo. No es redundante con la
      dimension «Idioma» de GA4: esa es el idioma del NAVEGADOR, no el de la
      pagina que se sirvio, y sin este parametro no se puede comparar como
      convierte /es frente a la version inglesa.
    */}
    <script is:inline define:vars={{ pageLang: lang }}>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ page_language: pageLang });
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-WHNFLL7H');
    </script>

    {/*
      ICONOS. Antes de esto el <head> no emitia NI UNO, asi que el navegador
      caia a /favicon.ico por convencion — y ese fichero era el logo de Astro,
      el que trae `npm create astro`. Salia el cohete en la pestana, en los
      favoritos y en los resultados de Google.

      Los seis ficheros los genera tools/generar-favicon.mjs a partir del logo
      oficial que ya vive en Sanity. No se dibujo nada nuevo.

      El .ico va PRIMERO y sin `type`: es el unico que entienden los rastreadores
      viejos, y Google lo quiere en multiplos de 48px (lleva 16, 32 y 48 dentro).
      El SVG va despues porque quien lo soporta lo prefiere sobre el .ico
      independientemente del orden.
    */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#243137" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {otro && (
      <>
        <link rel="alternate" hreflang="en" href={hrefEn} />
        <link rel="alternate" hreflang="es" href={hrefEs} />
        <link rel="alternate" hreflang="x-default" href={hrefEn} />
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:site_name" content={NEGOCIO.nombre} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content={String(OG_ANCHO)} />
    <meta property="og:image:height" content={String(OG_ALTO)} />
    <meta property="og:image:alt" content={ogAlt} />
    {/* Sin summary_large_image la tarjeta sale con una miniatura cuadrada al
        lado del texto, no con la imagen a lo ancho. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {/*
      Typekit: SOLO la hoja de estilos. El <script> blq3zch.js + Typekit.load()
      del sitio original es el cargador antiguo y duplica la misma peticion.
      El kit sirve `stix-two-text`, que alimenta .h1/.h2/.h3 (61 usos): es carga
      estructural, no se puede quitar.

      OJO (D9): los kits de Typekit estan restringidos por dominio. Hasta que
      alguien anada *.vercel.app al kit, los titulares caeran a sans-serif en
      las previews. Es esperado, NO es un port de CSS mal hecho.
    */}
    {/*
      p.typekit.net NO es un descuido: la hoja de Typekit de abajo lleva dentro
      un `@import` al pixel de uso de Adobe, que vive en OTRO dominio. Medido en
      produccion con Lighthouse, esa es la cadena critica mas larga de la pagina:

          HTML -> use.typekit.net/blq3zch.css -> p.typekit.net/p.css

      El tercer salto son 175 bytes, pero al ser un origen nuevo cuesta DNS +
      TCP + TLS enteros, y no se descubre hasta que la hoja de Typekit ha
      llegado y se ha parseado. El preconnect adelanta ese handshake en
      paralelo. No se puede quitar el @import: lo emite Adobe, no nosotros.
    */}
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/blq3zch.css" />

    {/*
      El sitio original cargaba 24 variantes con webfont.js: Ubuntu, Open Sans y
      Roboto en todos sus pesos y cursivas. Roboto no lo pide el CSS ni una vez,
      y de Open Sans solo se usa el 600 (`.h3.title-faq`, accounting-max:727).

      Pero de Ubuntu — que es la familia del `body` (linea 90) — el CSS pide
      CINCO caras, no una. Medido contra el baseline con una cadena de prueba a
      40px: con solo la 400 cargada, Chrome renderiza los cinco pesos con el
      MISMO fichero (289,33px en 300/400/500/600/700), mientras que produccion
      da 285,56 / 289,33 / 295,28 / 301,28. O sea: ni los <strong>, ni los
      titulares sin clase, ni los textos ligeros pesaban lo que deben.

        300  .title-cms-services (144 usos) · .info-contact-page @<=479
        400  body
        500  .title-special · .title-blog · .name-customer · .info-contact-page
        700  h1 · h2 · .top-title-contact-page · todo <strong>
        400 cursiva  <em> (rich text de servicios y de /about-us)

      Ni una variante mas: el unico 600 de Ubuntu seria `.h2-2`, y esa clase no
      aparece en ninguno de los 26 HTML del baseline ni en `src/`.

      ESAS SEIS CARAS YA NO VIENEN DE GOOGLE: estan auto-alojadas en
      /fonts/google/ y declaradas en src/styles/fuentes.css, que entra por
      main.css. Se quitaron de aqui el <link> a fonts.googleapis.com y sus dos
      preconnect porque eran DOS origenes en el camino critico y en cadena: el
      CSS de googleapis bloquea el render, y hasta que no llegaba y se parseaba
      no se descubrian los .woff2, que ademas viven en gstatic.com — un tercer
      origen con su propio handshake. Auto-alojadas, los ficheros salen del
      mismo origen que ya esta conectado y las declaraciones viajan dentro del
      CSS del sitio.

      Ubuntu (OFL) y Open Sans (Apache 2.0) lo permiten. stix-two-text no: es de
      Adobe y sus Terms of Use prohiben servirla uno mismo, por eso el <link> de
      Typekit de arriba se queda.

      Se precarga UNA sola cara, Ubuntu 400 latin: es la del <body>, la que hace
      falta para pintar el primer texto. Precargar las demas competiria por
      ancho de banda con esa y con el LCP. `crossorigin` es obligatorio aunque
      sea del mismo origen — las fuentes se piden en modo CORS y sin el atributo
      el navegador descarga el fichero DOS veces.
    */}
    <link
      rel="preload"
      href="/fonts/google/ubuntu-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Eliminado respecto al sitio original:
      - webfont.js de Google + WebFont.load(): 24 variantes, 2 en uso real.
      - el <script> blq3zch.js + Typekit.load(): cargador antiguo que duplica
        la peticion que ya hace el <link> de arriba.
      - jQuery 3.5.1 y webflow.js (211 KB): los sustituye JS propio en FASE 3.
      - Swiper desde unpkg SIN version fijada.
      Analitica: ninguna todavia, a proposito (D7).
    */}
    {/*
      Con Turnstile obligatorio, un envio sin JS no lleva token y el servidor lo
      rechaza con 403: el navegador se iria a una pagina de JSON en crudo. Un
      formulario que no puede funcionar es peor que ningun formulario, asi que
      sin JS se oculta y queda el aviso de <noscript> con el telefono.

      Vive aqui y no en cada pagina porque #newsletter-form esta en las 54
      rutas. Y va en el <head>: ahi <noscript> SI admite <style>; en el <body>
      no lo admite y el HTML dejaria de ser valido.
    */}
    <noscript>
      <style>
        #lead-form,
        #newsletter-form {
          display: none;
        }
      </style>
    </noscript>

    {/*
      ENTRADAS POR SCROLL. El estado oculto vive detras del sello que escribe
      este script (`data-entradas` en <html>): si no corre, el selector de
      site.css no casa y TODO se ve. No es un detalle — es la leccion del port.
      Los `data-w-id` + `style="opacity:0"` de Webflow se quitaron a mano de las
      26 rutas porque sin webflow.js dejaban el H1, el bloque about y el FAQ
      invisibles para siempre (ver cabecera de src/pages/index.astro).

      Va INLINE y en el <head> por dos razones distintas:
      - Un <script> normal de Astro sale como type="module" en el <body>, o sea
        diferido. Sellar desde ahi se ve como visible -> oculto -> visible, que
        es un parpadeo y no una animacion.
      - El sello solo se escribe DESPUES de construir el observador. Sellar
        antes y que el observador falle deja todo invisible: seria el fallo de
        Webflow otra vez, entrando por la puerta de atras.

      JAVASCRIPT PLANO, sin TypeScript. `astro check` funde todos los is:inline
      de un .astro en un inline.mjs virtual y le pide getSyntacticDiagnostics a
      TypeScript: una anotacion de tipo o un generico da TS8010 y tumba
      `npm run check`, que es puerta de despliegue. El resto de <script> del
      repo SI son TypeScript porque los procesa Vite; este no.
    */}
    <script is:inline>
      (function () {
        var raiz = document.documentElement;
        var io;

        // PROFUNDIDAD DEL DISPARO. El bloque no se revela al asomar por el
        // canto, sino cuando su borde superior llega a ~45% de la ventana, o
        // sea con el bloque ya en la mitad de la pantalla. Con el disparo en el
        // borde la animacion ocurre fuera del campo de atencion y para cuando
        // el usuario mira el bloque ya termino: se veia el resultado, no la
        // entrada. Esto es lo que hace que se aprecie al hacer scroll.
        //
        // Se acota a 400px, y el tope no es cosmetico: la franja que nunca
        // cruza el umbral es la ultima del documento, y con un porcentaje puro
        // esa franja creceria con la ventana hasta dejar un bloque invisible
        // para siempre. Medido en la portada: el pie mide 1403px y el ultimo
        // bloque marcado queda 1071px POR ENCIMA del borde superior a scroll
        // maximo, asi que 400px sobra por un factor de 2,7. El pie va en las 54
        // rutas y nunca lleva token: es el que da la garantia.
        // El freno es el precio del umbral profundo, y hay que verlo asi: el
        // bloque esta OCUPANDO pantalla mientras sigue invisible, asi que la
        // banda vacia que se ve antes del fundido mide exactamente `freno`. A
        // 0,45 de la ventana eran 380px en un movil de 844 — el 45% de la
        // pantalla en hueco, y en la portada le pasaba a 6 de 14 bloques.
        //
        // 0,25 con tope de 200px deja la banda en ~24% de la pantalla y el
        // disparo a tres cuartos de altura: el bloque sigue entrando bien
        // dentro del campo de vision, pero ya no abre un agujero. Es un
        // compromiso REAL entre dos peticiones opuestas —«que dispare en la
        // mitad de la pantalla» y «que no se vea el hueco»— porque las dos
        // mueven este mismo numero en direcciones contrarias.
        var freno = Math.min(Math.round(window.innerHeight * 0.25), 200);
        var ioBorde;
        try {
          io = new IntersectionObserver(alVer, {
            rootMargin: "0px 0px -" + freno + "px 0px",
            threshold: 0,
          });
          // SEGUNDO OBSERVADOR, sin freno, para los bloques que NO CABEN en la
          // pantalla. Un bloque mas alto que la ventana no puede «entrar»:
          // nunca se le ve entero, asi que el umbral profundo solo consigue que
          // se scrolleen `freno` px con el bloque ya en pantalla y en blanco
          // antes de que arranque el fundido. Medido en /contact-us a 390x844:
          // 380px de scroll con el 45% de la pantalla vacia. Y no era un caso
          // aislado — a 390 hay seis bloques asi, desde 1,0x en la portada
          // hasta 7,3x en /terms.
          //
          // Para esos, el disparo va en el borde de la ventana: el bloque se
          // funde segun asoma, sin hueco previo. El umbral profundo se queda
          // para lo que si cabe en pantalla, que es donde tiene sentido.
          ioBorde = new IntersectionObserver(alVer, { threshold: 0 });
        } catch (e) {
          return;
        }
        raiz.setAttribute("data-entradas", "");

        function revelar(el) {
          el.setAttribute("data-visto", "");
          // Sobre un elemento que no observa, `unobserve` no hace nada.
          io.unobserve(el);
          ioBorde.unobserve(el);
        }

        function alVer(entradas) {
          for (var i = 0; i < entradas.length; i++) {
            if (entradas[i].isIntersecting) revelar(entradas[i].target);
          }
        }

        // Tabular no puede llevar el foco a algo invisible (SC 2.4.7 / 2.4.11).
        // Se registra ya, no dentro del DOMContentLoaded, para cubrir el foco
        // que llega por fragmento de URL antes de que exista el observador.
        document.addEventListener("focusin", function (e) {
          var el = e.target && e.target.closest ? e.target.closest("[data-entra],[data-entra-cascada]") : null;
          while (el) {
            revelar(el);
            el = el.parentElement ? el.parentElement.closest("[data-entra],[data-entra-cascada]") : null;
          }
        });

        document.addEventListener("DOMContentLoaded", function () {
          try {
            var nodos = document.querySelectorAll("[data-entra],[data-entra-cascada]");
            for (var i = 0; i < nodos.length; i++) {
              // PRIMER PASE, contra la ventana DE VERDAD y no contra la raiz
              // encogida del observador: lo que ya se ve al aterrizar se revela
              // sin animar y ni se observa. Dos motivos:
              //   - Un elemento en opacity:0 no cuenta como pintado para el
              //     LCP, y DOMContentLoaded espera a la hoja bloqueante de
              //     Typekit de mas arriba. Revelar ya lo que se ve quita ese
              //     retraso, y de paso evita que al recargar a media pagina o
              //     volver por bfcache se funda de golpe media pantalla.
              //
              // El corte es LA MISMA LINEA que usa el observador, no el borde
              // de la ventana. Con el borde, un bloque que solo asoma unos
              // pixeles al aterrizar se daba por visto y NO se animaba nunca:
              // medido en /about-us, la barra de 4 caracteristicas empieza en
              // 779 con la ventana en 900 —asoma 121px, el 30% de su alto— y
              // aparecia ya puesta. Un mismo umbral para las dos cosas.
              // Un bloque que no cabe en la pantalla usa el BORDE de la ventana
              // como umbral, tanto aqui como en su observador: con el umbral
              // profundo se quedaria en blanco ocupando media pantalla durante
              // `freno` px de scroll. Ver el comentario de `ioBorde`.
              var caja = nodos[i].getBoundingClientRect();
              var noCabe = caja.height > window.innerHeight;
              var umbral = noCabe ? window.innerHeight : window.innerHeight - freno;
              if (caja.bottom > 0 && caja.top < umbral) nodos[i].setAttribute("data-visto", "");
              else (noCabe ? ioBorde : io).observe(nodos[i]);
            }
            // La animacion se habilita un frame despues, para que lo revelado
            // arriba no llegue a animarse. Mismo patron que `data-cromo-listo`
            // en ui.ts, y por la misma razon.
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                raiz.setAttribute("data-entradas-listo", "");
              });
            });
          } catch (e) {
            // Fallo a mitad de camino: se retira el sello y todo vuelve a ser
            // visible. Preferible un sitio sin animacion a un sitio en blanco.
            raiz.removeAttribute("data-entradas");
          }
        });
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    {/* Mitad `noscript` del contenedor. Sin JS no hay GA4 de todos modos, asi
        que no mide nada por si sola: se pone porque es el snippet canonico y
        porque el comprobador de instalacion de GTM la busca. Va lo primero
        dentro del <body>, como pide Google. */}
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WHNFLL7H"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >

    {/* SC 2.4.1 — Bypass Blocks. No habia ninguno en las 54 rutas, y en
        escritorio el cromo mete el logo, 5 enlaces, el CTA y los 12 del
        desplegable antes del contenido. Oculto hasta que recibe el foco, que
        es el patron estandar; el destino es el <main id="main"> de cada ruta. */}
    <a href="#main" class="saltar-al-contenido">{t(lang).nav.saltar}</a>
    <slot />

    {/* Acceso a WhatsApp (ver WhatsAppWidget.astro). Sustituye al chat de IA:
        aqui no hay bundle, ni peticiones, ni cookies — es un enlace. */}
    <WhatsAppWidget lang={lang} />
  </body>
</html>
