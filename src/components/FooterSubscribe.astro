---
// Formulario de newsletter del pie.
//
// Estructura y clases de baseline/html/index.html:
//   section.footer > .email-subscribed > .container > section.footer-subscribe
// (OJO: en index/about-us/services hay OTRA section.footer-subscribe, la del
// "Schedule a free consultation call Today!". Esa es una seccion de pagina, no
// cromo, y la construye el agente de cada pagina.)
//
// El endpoint /api/newsletter lo crea la FASE 4. Hasta entonces el POST
// devuelve 404 y el bloque de error EN LINEA lo dice. No se redirige a
// /thank-you: esa pagina no existe y contar el pageview de un "gracias" como
// conversion ya dio seis meses de datos falsos en otro proyecto.
//
// FASE 5 — bilingue. `lang` llega por prop desde Footer; si no llega, se
// deduce de la ruta. En `en` las cadenas son las mismas que estaban aqui a
// mano. UNICO cambio visible en el HTML EN: el submit gana data-wait, porque
// el <script> se compila aparte y no puede leer el frontmatter — sin ese
// atributo el boton diria "Please wait..." tambien en /es/. Es el mismo patron
// que ya usa el formulario de /contact-us.
import { sanity, NEGOCIO } from "../lib/sanity";
import { t, idiomaDeRuta, interpola, type Lang } from "../lib/i18n";
import { SITE_KEY } from "../lib/turnstile";

interface Props {
  lang?: Lang;
}
const { lang = idiomaDeRuta(Astro.url.pathname) } = Astro.props;
const c = t(lang);

type Asset = { url: string; w: number; h: number };
const g = globalThis as any;
const icono: Asset = await (g.__amsIconoNews ??= sanity
  .fetch<Asset[]>(
    `*[_type == "sanity.imageAsset" && originalFilename == $f]{
       url, "w": metadata.dimensions.width, "h": metadata.dimensions.height
     }`,
    { f: "678076a8aa08ffbbdb095352-news.svg" },
  )
  .then((r) => {
    if (!r[0]) throw new Error("Falta en Sanity el icono de newsletter (news.svg).");
    return r[0];
  }));
---

<section class="footer-subscribe">
  <div class="wrapper-form-email">
    <div class="block-title-form-email">
      {/* Decorativo: el titular de al lado ya dice que es la newsletter. */}
      <img
        src={icono.url}
        width={icono.w}
        height={icono.h}
        alt=""
        loading="lazy"
        decoding="async"
        class="icon-news"
      />
      <div>
        <h2 class="h2 white">{c.newsletter.title}</h2>
        <div>{c.newsletter.text}</div>
      </div>
    </div>

    <div class="form-block w-form">
      {/* Sin JS el formulario se OCULTA (ver el <noscript> de BaseLayout): sin
          token de captcha el endpoint responde 403, y mandar a la persona a una
          pagina de JSON en crudo es peor que no ensenarle el formulario. */}
      <noscript>
        <p>{interpola(c.newsletter.sinJs, { email: NEGOCIO.email })}</p>
      </noscript>
      <form
        id="newsletter-form"
        method="post"
        action="/api/newsletter"
        data-captcha-error={c.errores.captcha}
      >
        {/* El sitio en produccion no tiene ni un <label> en las 26 rutas: solo
            placeholders, que desaparecen al escribir. */}
        <label class="visually-hidden" for="newsletter-email">{c.newsletter.emailLabel}</label>
        <div class="block-form-email">
          <input
            id="newsletter-email"
            class="text-field w-input"
            type="email"
            name="email"
            maxlength="256"
            placeholder={c.newsletter.emailPlaceholder}
            autocomplete="email"
            required
          />
          <input
            type="submit"
            class="button-news w-button"
            value={c.newsletter.submit}
            data-wait={c.newsletter.wait}
          />
        </div>

        {/* `lang` explicito: el pie sale en las 54 rutas y de este campo depende
            el idioma del mensaje de error. idiomaDe() de /api/newsletter lo
            prefiere al Referer, que se puede perder por politica del navegador. */}
        <input type="hidden" name="lang" value={lang} />

        {/*
          Turnstile. Va FUERA de .block-form-email a proposito: esa caja es un
          flex en fila donde el campo y el boton comparten el borde redondeado
          (la "pastilla"), y un tercer hijo de 300px la parte en dos.

          CONSECUENCIA ASUMIDA: el reto queda DESPUES del boton en el orden de
          tabulacion. Es el unico sitio posible sin rehacer la pastilla, que es
          rediseno y no antibot. Por eso turnstile.ts lleva el foco a la caja en
          cuanto Cloudflare pide un clic con el envio ya en marcha.

          Sin reservar alto, al reves que en /contact-us: aqui el widget crece
          hacia ABAJO, lejos del campo en uso, y reservar 65px dejaria un hueco
          permanente en el pie de las 54 rutas.
        */}
        {SITE_KEY && (
          <div data-turnstile data-sitekey={SITE_KEY} data-lang={lang} data-theme="dark"></div>
        )}

        {/* Trampa anti-bots. Se llama 'ref_id' y NO 'company_url' a proposito:
            los gestores de contrasenas autocompletan cualquier campo que huela
            a empresa o URL y marcarian como bot a personas reales. */}
        <div class="visually-hidden" aria-hidden="true">
          <label for="newsletter-ref-id">{c.newsletter.honeypot}</label>
          <input
            id="newsletter-ref-id"
            type="text"
            name="ref_id"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
      </form>

      {/* Confirmacion en linea, replicando el w-form-done de Webflow. */}
      <div class="w-form-done" role="status" tabindex="-1" data-newsletter-done>
        <div>{c.newsletter.done}</div>
      </div>
      <div class="w-form-fail" role="alert" tabindex="-1" data-newsletter-fail>
        <div>{c.newsletter.fail}</div>
      </div>
    </div>
  </div>
</section>

<script>
  import { armarCaptcha, tokenCaptcha, reiniciarCaptcha } from "../scripts/turnstile";

  // Mejora progresiva del envio. Con Turnstile obligatorio este script ya no es
  // solo cosmetico: sin el no hay token, asi que sin JS el formulario se oculta
  // (ver el <noscript> de BaseLayout) y queda el aviso con el correo.
  const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
  const bloque = form?.closest(".form-block") as HTMLElement | null;
  const hecho = bloque?.querySelector<HTMLElement>("[data-newsletter-done]");
  const fallo = bloque?.querySelector<HTMLElement>("[data-newsletter-fail]");
  const enviar = form?.querySelector<HTMLInputElement>('input[type="submit"]');

  if (form && hecho && fallo && enviar) {
    const etiqueta = enviar.value;
    // El rotulo de espera viaja en data-wait: el <script> no ve el frontmatter.
    const espera = enviar.dataset.wait ?? "Please wait...";

    // .w-form-done/.w-form-fail son display:none en el CSS portado; Webflow los
    // mostraba con estilo en linea y aqui se hace igual (no hay CSS nuevo).
    //
    // El texto se escribe ANTES de mostrar y enfocar: role="alert" + focus()
    // anuncia lo que hay en ese instante, y escribirlo despues hace que el
    // lector lea el mensaje viejo. textContent y NUNCA innerHTML: viene de una
    // respuesta HTTP.
    const mostrar = (el: HTMLElement, texto = "") => {
      if (texto) (el.firstElementChild ?? el).textContent = texto;
      el.style.display = "block";
      el.focus();
    };
    const ocultar = (el: HTMLElement) => {
      el.style.display = "";
    };

    // Fachada: nada de challenges.cloudflare.com hasta el primer foco.
    armarCaptcha(form);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      ocultar(fallo);

      enviar.disabled = true;
      enviar.value = espera;

      // Vacio = se queda el texto que ya trae el HTML, que el frontmatter dejo
      // traducido. Solo lo pisa quien tenga algo mejor y en el idioma correcto.
      let motivo = "";
      try {
        // El servidor responde 403 a un envio sin token, asi que se espera al
        // reto ANTES de gastar un intento del limite por IP.
        const cf = await tokenCaptcha(form).catch(() => {
          motivo = form.dataset.captchaError ?? "";
          throw new Error("captcha");
        });
        const datos = new FormData(form);
        if (cf) datos.set("cf-turnstile-response", cf);

        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: datos,
        });
        if (!res.ok) {
          // El JSON trae el error YA en el idioma de la pagina (campo `lang`).
          // Si la respuesta no es JSON (un 502 devuelve HTML) se queda el texto
          // del HTML.
          const cuerpo = await res.json().catch(() => null);
          if (typeof cuerpo?.error === "string" && cuerpo.error) motivo = cuerpo.error;
          throw new Error(String(res.status));
        }
        form.style.display = "none";
        mostrar(hecho);
      } catch {
        // El token es de un solo uso: si el servidor llego a verificarlo, el
        // siguiente envio con el mismo token da "timeout-or-duplicate".
        reiniciarCaptcha(form);
        mostrar(fallo, motivo);
      } finally {
        enviar.disabled = false;
        enviar.value = etiqueta;
      }
    });
  }
</script>
