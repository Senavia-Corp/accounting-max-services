---
// Plantilla de servicio — 12 rutas /services/<slug>.
//
// Estructura y clases copiadas de baseline/html/services/<slug>.html, que es
// identico en las 12 salvo el cuerpo, el titular, la intro y la foto. Verificado
// por hash: las secciones .call-action y .features son byte a byte la misma en
// las 12, y el carrusel trae los 20 testimonios en todas.
//
// Secciones: header-page · call-action · body-service · reviews (+ wrapper-
// reviews) · features. En ese orden.
//
// Diferencias deliberadas respecto al HTML de produccion (todas justificadas
// donde ocurren): sin data-w-id ni style="opacity:0", sin segundo <h1>, flechas
// del carrusel como <button>, <main> real, alt escritos, y el <style> del
// .w-embed movido al bloque <style> del final.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PortableText from "../../components/PortableText.astro";
import LeadForm from "../../components/LeadForm.astro";
import JsonLd from "../../components/JsonLd.astro";
import { servicios, testimonios, sanity, ogUrl, NEGOCIO } from "../../lib/sanity";
import type { Servicio, Testimonio } from "../../lib/sanity";
import type { GetStaticPaths } from "astro";
import { relacionados } from "../../lib/familias";
import { t } from "../../lib/i18n";

type Asset = { originalFilename: string; url: string; w: number; h: number };

export const getStaticPaths = (async () => {
  // Assets estaticos de la plantilla (no son de ningun documento): el icono de
  // la llamada a la accion, el logo y las estrellas del carrusel, la flecha de
  // las pistas y las 3 ilustraciones de .features. Estan en Sanity como assets
  // sueltos; las URLs de cdn.prod.website-files.com estan prohibidas.
  // Va DENTRO de getStaticPaths: Astro lo saca a modulo aparte y no ve las
  // constantes del frontmatter.
  const MARCA = [
    "6785bf353063de8bcbcf3dfc-icon-13.svg",
    "684a14073e3e3c127cc2a314-logo-google-reviews.svg",
    "684a14073e3e3c127cc2a315-starts.svg",
    "684a15893000dfa033be0899-684a120d78059a4010848353-arow.svg",
    "66591cff761a876e791ad585-1.png",
    "66591defc9bd4c2b2a6fd8c8-2.png",
    "66591fc962e8774f9117068b-3.png",
  ];

  const [servs, resenas, assets] = await Promise.all([
    servicios(),
    testimonios(),
    sanity.fetch<Asset[]>(
      `*[_type == "sanity.imageAsset" && originalFilename in $f]{
         originalFilename, url,
         "w": metadata.dimensions.width,
         "h": metadata.dimensions.height
       }`,
      { f: MARCA },
    ),
  ]);

  // R4: `sales-tax-filing-7k40q` es la URL viva e indexada y el sufijo es el
  // desempate de Webflow, no ruido. Si alguien "limpia" el slug en Sanity, el
  // build cae aqui y no en el 404 de un cliente.
  if (!servs.some((s) => s.slug === "sales-tax-filing-7k40q")) {
    throw new Error(
      "R4: falta el slug exacto 'sales-tax-filing-7k40q'. No se toca ni se normaliza.",
    );
  }

  return servs.map((s) => ({
    params: { slug: s.slug },
    props: { servicio: s, todos: servs, resenas, assets },
  }));
}) satisfies GetStaticPaths;

interface Props {
  servicio: Servicio;
  todos: Servicio[];
  resenas: Testimonio[];
  assets: Asset[];
}

const { servicio, todos, resenas, assets } = Astro.props;

/** Falla en voz alta: un asset roto se ve en las 12 rutas. */
const img = (nombre: string): Asset => {
  const a = assets.find((x) => x.originalFilename === nombre);
  if (!a) throw new Error(`Falta en Sanity el asset "${nombre}".`);
  return a;
};

const iconoCta = img("6785bf353063de8bcbcf3dfc-icon-13.svg");
const logoGoogle = img("684a14073e3e3c127cc2a314-logo-google-reviews.svg");
const estrellas = img("684a14073e3e3c127cc2a315-starts.svg");
const flecha = img("684a15893000dfa033be0899-684a120d78059a4010848353-arow.svg");

// Transformaciones de Sanity. Prohibido AVIF, y por eso `fm=webp` y NO
// `auto=format`: `auto=format` no fija formato, negocia por la cabecera
// `Accept`, y Chrome pide `image/avif` primero — asi que el CDN devolvia AVIF.
// `fm=webp` fuerza WebP sea cual sea el navegador. Los SVG no pasan por aqui
// (se sirven crudos): `fm=webp` los rasterizaria.
// Los SVG no se transforman, van con su URL cruda.
const src = (u: string, w: number) => `${u}?w=${w}&q=75&fm=webp`;

const titulo = servicio.title.trim();
const intro = servicio.intro?.trim();

// SEO. Hoy las 26 rutas comparten el <title> "Accounting Max Services" y
// NINGUNA tiene meta description. Sanity tiene los campos pero estan vacios en
// las 12: se emite lo que haya y, si no hay, se compone con el titulo del
// servicio y el nombre del negocio — ambos dato real, no invencion (R3).
const metaTitle = servicio.metaTitle?.trim() || `${titulo} | ${NEGOCIO.nombre}`;
// La intro es copia real del CMS. Si no hubiera, no se emite meta description:
// un {{PENDIENTE}} en el <head> no lo ve nadie y acabaria en los resultados.
const metaDescription = servicio.metaDescription?.trim() || intro || undefined;

// Alt de la foto de cabecera. Deberia vivir en Sanity (el esquema lo exige) pero
// los 12 documentos lo traen a null tras el import, asi que aqui hay un texto
// escrito MIRANDO cada foto — nunca el nombre del fichero. En cuanto alguien
// rellene picture.alt en el CMS, este mapa deja de usarse.
const ALT_FOTO: Record<string, string> = {
  "audit-assistance":
    "A Form 1040 tax return stamped AUDIT in red, next to a calculator and a keyboard.",
  "bilingual-services-english-spanish":
    "Two jigsaw pieces printed with the United States and Spanish flags fitting together over a world map.",
  "business-incorporation-in-florida":
    "Two people in aprons standing in the doorway of their shop, beside an Open sign.",
  "corporate-tax-preparation":
    "A person in a suit filling in tax paperwork at a desk, next to an open laptop.",
  "employer-identification-number-application":
    "A clipboard holding an Employer Identification Number form, on a desk with a pen and a keyboard.",
  "financial-statement-preparation":
    "A magnifying glass over the printed bar and pie charts of a financial report.",
  "itin-application-irs-tax-id":
    "Close-up of IRS Form W-7, Application for IRS Individual Taxpayer Identification Number.",
  "monthly-bookkeeping-accounting":
    "A person at a desk reviewing printed bar and pie chart reports beside a calculator.",
  "notary-public-services":
    "A hand pressing a stamp onto a document at a desk, across from a client.",
  "personal-tax-preparation":
    "Printed tax return forms with eyeglasses, a calculator, banknotes and a United States flag.",
  "representation-before-the-irs":
    "Photo montage of a columned government building over a United States banknote.",
  "sales-tax-filing-7k40q":
    "Hands typing on a laptop with financial charts and figures overlaid on the screen.",
};

const foto = servicio.picture;
const altFoto = foto?.alt?.trim() || ALT_FOTO[servicio.slug] || "";

// Los 3 bloques de .features. Titulares y parrafos transcritos verbatim del
// baseline (incluidas sus comillas rectas o curvas, que alternan); el <strong>
// va como HTML porque es texto fijo de plantilla escrito aqui, no del CMS.
// Los alt estan escritos mirando las ilustraciones. Las cifras que salen
// dentro de los mockups NO se transcriben: son relleno del diseno (R3).
const FEATURES = [
  {
    imagen: img("66591cff761a876e791ad585-1.png"),
    alt: "Illustration of a chat window with a Book a call button and portraits of two people on the phone.",
    titulo: "One-on-one expert support",
    parrafo:
      "We believe in building strong, lasting relationships with our clients. With <strong>one-on-one expert support</strong>, you&#x27;ll have direct access to knowledgeable professionals who understand your unique financial needs. Whether you&#x27;re a business owner or an individual, we&#x27;ll work closely with you to ensure all your questions are answered and your goals are met with precision. Our personalized approach ensures you never feel lost in the process—you&#x27;re always in capable hands.",
    invertido: false,
  },
  {
    imagen: img("66591fc962e8774f9117068b-3.png"),
    alt: "Illustration of an accounting dashboard showing a sales revenue summary and a breakdown of top expenses.",
    titulo: "Powerful financial reporting",
    parrafo:
      "Our <strong>financial reporting</strong> services provide you with detailed, accurate insights into the health of your business or personal finances. We prepare <strong>customized financial statements</strong> such as income statements, balance sheets, and cash flow reports to help you make informed decisions. With our <strong>powerful financial reporting</strong>, you’ll gain a clear understanding of your financial position, giving you the tools to plan effectively, secure funding, and grow your business with confidence.",
    invertido: true,
  },
  {
    imagen: img("66591defc9bd4c2b2a6fd8c8-2.png"),
    alt: "Illustration of an accounting dashboard with revenue, expense and net profit cards and a monthly trend chart.",
    titulo: "Tax season, minus the stress",
    parrafo:
      "Tax season can be overwhelming, but with Accounting Max Services, it doesn’t have to be. We handle every aspect of <strong>tax preparation</strong>—from gathering your documents to filing your returns—so you can relax. Our goal is to make the process as seamless and stress-free as possible, ensuring that your taxes are filed accurately, on time, and with maximum refunds or minimized liabilities. With our team by your side, you’ll never have to worry about tax season again.",
    invertido: false,
  },
];

const aqui = `/services/${servicio.slug}`;

const c = t("en");

// FASE 3: 2-3 hermanos de la misma familia en vez de la caja con los DOCE.
const hermanos = relacionados(todos, servicio.slug);
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  ogImage={ogUrl(foto)}
  ogImageAlt={altFoto || undefined}
>
  <JsonLd tipo="service" nombre={titulo} descripcion={metaDescription} imagen={foto?.url} />
  <Nav />

  {/* El baseline no tiene <main>: las 26 rutas van de <section> en <section>
      sin un solo landmark de contenido principal. */}
  <main id="main">
    {/* =============================================================== HERO */}
    {/* FASE 3. La ficha deja de ser una ficha y pasa a ser una landing: es el
        destino de una campana que gasta $120/dia y hasta hoy no tenia ni
        formulario propio, ni precio, ni un siguiente paso que no fuera saltar
        a otra pagina. */}
    <section class="servicio__hero">
      <div class="contenido">
        <p class="servicio__eyebrow">{c.nav.services}</p>
        <h1 class="servicio__titulo">{titulo}</h1>
        {intro && <p class="servicio__intro">{intro}</p>}
        <div class="hero__acciones">
          <a href="#lead-titulo" class="boton boton--principal">{c.form.submit}</a>
          <a href={NEGOCIO.telefonoHref} class="boton boton--secundario">
            {`Call ${NEGOCIO.telefono}`}
          </a>
        </div>
      </div>
    </section>

    {/* ============================================================= CUERPO */}
    {/* La prosa manda y el formulario acompana. En movil el formulario baja
        debajo: primero se entiende el servicio, luego se pide presupuesto.

        FUERA la caja «Global Financial Solutions», que repetia los DOCE
        servicios y ocupaba la mitad exacta del cuerpo en las 24 fichas.
        Devolver al menu completo a quien ya eligio es lo que mata la
        conversion en una landing. */}
    <section class="seccion">
      <div class="contenido">
        <div class="servicio__cuerpo">
          <div class="w-richtext">
            {foto && (
              <img
                src={src(foto.url, 1080)}
                srcset={[500, 800, 1080].map((w) => `${src(foto.url, w)} ${w}w`).join(", ")}
                sizes="(max-width: 62rem) 100vw, 55vw"
                width={foto.w}
                height={foto.h}
                alt={altFoto}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                style="width:100%;height:auto;border-radius:var(--radio-caja);margin-bottom:var(--e-6)"
              />
            )}
            <PortableText value={servicio.body} />
          </div>
          <aside class="servicio__aparte">
            <LeadForm lang="en" servicio={servicio.slug} />
          </aside>
        </div>
      </div>
    </section>

    {/* ======================================================= RELACIONADOS */}
    {
      hermanos.length > 0 && (
        <section class="seccion seccion--alterna" aria-labelledby="relacionados-titulo">
          <div class="contenido">
            <div class="cabecera-seccion">
              <h2 id="relacionados-titulo">{c.service.relacionados}</h2>
            </div>
            <ul class="relacionados">
              {hermanos.map((h) => (
                <li>
                  <a href={`/services/${h.slug}`} class="relacionado">
                    <span class="relacionado__nombre">{h.title.trim()}</span>
                    {h.intro && <span class="relacionado__intro">{h.intro.trim()}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }


    {/* ========================================================= TESTIMONIOS */}
    {/* Mismo componente que la portada: scroll-snap nativo, cero libreria.
        D5 intacto — se muestran como testimonios y nada mas. */}
    <section class="seccion" aria-labelledby="titulo-resenas">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="titulo-resenas">{c.reviews.title}</h2>
        </div>
        <div
          class="testimonios"
          data-carrusel
          tabindex="0"
          role="group"
          aria-labelledby="titulo-resenas"
        >
          {
            resenas.map((o) => (
              <figure class="testimonio">
                <blockquote class="testimonio__texto">{o.quote}</blockquote>
                <figcaption>
                  <div class="testimonio__autor">{o.author}</div>
                  <div class="testimonio__fuente">{c.reviews.publicado}</div>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="carrusel__mandos">
          <button type="button" class="carrusel__boton" data-carrusel-prev aria-label={c.reviews.prev}>
            &#8592;
          </button>
          <button type="button" class="carrusel__boton" data-carrusel-next aria-label={c.reviews.next}>
            &#8594;
          </button>
        </div>
      </div>
    </section>

    {/* ============================================================== CIERRE */}
    <section class="seccion seccion--oscura" aria-labelledby="cierre-titulo">
      <div class="contenido">
        <div class="cierre">
          <div class="cierre__texto">
            <h2 id="cierre-titulo">{c.home.cierreTitulo}</h2>
            <p>{c.home.cierreTexto}</p>
          </div>
          <div class="cierre__acciones">
            <a href="#lead-titulo" class="boton boton--principal">{c.form.submit}</a>
            <a href={NEGOCIO.telefonoHref} class="boton boton--secundario">
              {`Call ${NEGOCIO.telefono}`}
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* Los recortes (.background-services y las 4 esquinas de .reviews) ya viven en
   * site.css y son los mismos para toda la web: aqui estaban repetidos y, como
   * Astro emite el ambito como atributo, ganaban por especificidad y dejaban el
   * bloque de site.css inalcanzable. Una sola fuente de verdad, alli.
   *
   * Estas dos SI son de la pagina y no tienen copia en site.css: el hero de la
   * ficha lleva un lqip como background-image en linea, y sin ellas se repetiria
   * a tamano natural en vez de tapar la caja del LCP. */
  .background-services {
    background-size: cover;
    background-position: 50%;
  }
</style>
