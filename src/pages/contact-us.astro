---
// Ruta /contact-us.
//
// Estructura y clases de baseline/html/contact-us.html <section class="header-contact-page">.
// Los datos de contacto salen de NEGOCIO (src/lib/sanity.ts), no del HTML.
//
// Diferencias deliberadas respecto al HTML de produccion, todas justificadas
// mas abajo en su sitio:
//   - los 4 campos del Lead Form pasan a tener <label> real (hoy hay 0 <label>
//     en las 26 rutas: solo placeholders, que desaparecen al escribir);
//   - dos casillas de consentimiento separadas, llamadas y SMS (FTSA);
//   - los <a href="#"> de direccion y horario dejan de ser enlaces;
//   - el <div style="opacity:0"> de las interacciones de Webflow desaparece:
//     sin webflow.js ese estilo en linea deja el contenido INVISIBLE;
//   - el POST va a /api/lead con nombres de campo limpios, no a Webflow.
import LeadForm from "../components/LeadForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { NEGOCIO } from "../lib/sanity";
import { SITE_KEY } from "../lib/turnstile";

// El horario vive en NEGOCIO como una sola cadena; aqui va en dos lineas, igual
// que en produccion. Se parte, no se reescribe (mismo criterio que Footer).
const [dias, horas] = NEGOCIO.horario.split(" (");

/**
 * Marca de tiempo para el time-trap del servidor (FASE 4).
 *
 * OJO: esta pagina es estatica, asi que este valor es la hora del BUILD, no la
 * de la visita. El <script> de abajo lo sobreescribe con Date.now() al cargar.
 * Contrato para /api/lead:
 *   - rechazar si (ahora - ts) < 3000 ms  -> se envio demasiado rapido, es bot;
 *   - NO rechazar por antiguo: sin JS, o con la pagina servida desde cache, el
 *     valor legitimo es la hora del build y puede tener dias.
 * Es un filtro barato, no una firma: un bot decidido puede poner lo que quiera.
 */
const TS_BUILD = Date.now();

// La descripcion reutiliza el parrafo real de la pagina. En produccion no hay
// ni una sola meta description en las 26 rutas (R3: no se inventa copy nuevo).
const DESCRIPCION =
  "Talk to a bilingual Enrolled Agent in Coral Springs, FL. We are at " +
  "1700 N University Dr STE 210, Monday to Friday, and the first consultation is free.";
---

<BaseLayout title="Contact Our Coral Springs Office | Accounting Max Services" description={DESCRIPCION}>
  <Nav />

  <main id="main">
    <section class="header-contact-page">
      <div class="w-layout-blockcontainer container w-container">
        <div class="wrapper-contact-page">
          <div class="block-info-contact">
            <h1 class="h1">Contact Our Tax &amp; Accounting Experts in Coral Springs, FL</h1>
            <div>{DESCRIPCION}</div>

            <ul role="list" class="list">
              <li class="list-item">
                <a href={NEGOCIO.telefonoHref} class="block-icon-contact-page w-inline-block">
                  <div class="box-icon-contact">
                    {/* Iconos decorativos: el texto de al lado ya los nombra. */}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="35"
                      height="35"
                      viewBox="0 0 24 24"
                      class="ikonik-122hk"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="currentColor"
                        d="M15.795 6.791 13.005 4v6.995H20l-2.791-2.79 4.503-4.503-1.414-1.414z"></path>
                      <path
                        fill="currentColor"
                        d="M16.712 13.288a.999.999 0 0 0-1.414 0l-1.597 1.596c-.824-.245-2.166-.771-2.99-1.596-.874-.874-1.374-2.253-1.594-2.992l1.594-1.594a.999.999 0 0 0 0-1.414l-4-4a1.03 1.03 0 0 0-1.414 0l-2.709 2.71c-.382.38-.597.904-.588 1.437.022 1.423.396 6.367 4.297 10.268C10.195 21.6 15.142 21.977 16.566 22h.028c.528 0 1.027-.208 1.405-.586l2.712-2.712a.999.999 0 0 0 0-1.414l-3.999-4zM16.585 20c-1.248-.021-5.518-.356-8.874-3.712C4.343 12.92 4.019 8.636 4 7.414l2.004-2.005L8.59 7.995 7.297 9.288c-.238.238-.34.582-.271.912.024.115.611 2.842 2.271 4.502s4.387 2.247 4.502 2.271a.994.994 0 0 0 .912-.271l1.293-1.293 2.586 2.586L16.585 20z"
                      ></path>
                    </svg>
                  </div>
                  <div class="block-info-page">
                    <div class="top-title-contact-page">Let&#x27;s talk!</div>
                    <div class="info-contact-page">{NEGOCIO.telefono}</div>
                  </div>
                </a>
              </li>

              <li class="list-item">
                <a
                  href={`mailto:${NEGOCIO.email}`}
                  class="block-icon-contact-page w-inline-block"
                >
                  <div class="box-icon-contact">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="35"
                      height="35"
                      viewBox="0 0 1024 1024"
                      class="ikonik-dn3cw"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="currentColor"
                        d="M928 160H96c-17.7 0-32 14.3-32 32v640c0 17.7 14.3 32 32 32h832c17.7 0 32-14.3 32-32V192c0-17.7-14.3-32-32-32zm-40 110.8V792H136V270.8l-27.6-21.5 39.3-50.5 42.8 33.3h643.1l42.8-33.3 39.3 50.5-27.7 21.5zM833.6 232L512 482 190.4 232l-42.8-33.3-39.3 50.5 27.6 21.5 341.6 265.6a55.99 55.99 0 0 0 68.7 0L888 270.8l27.6-21.5-39.3-50.5-42.7 33.2z"
                      ></path>
                    </svg>
                  </div>
                  <div class="block-info-page">
                    <div class="top-title-contact-page">Send us a message!</div>
                    <div class="info-contact-page">{NEGOCIO.email}</div>
                  </div>
                </a>
              </li>

              {/*
                Direccion y horario eran <a href="#">: enlaces a ninguna parte.
                Aqui dejan de ser enlaces. No se inventa una URL de Google Maps
                (R3) y un enlace que no lleva a ningun sitio es peor que ninguno.
              */}
              <li class="list-item">
                <div class="block-icon-contact-page">
                  <div class="box-icon-contact">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="35"
                      height="35"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="ikonik-1cr66"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M12 2C7.58172 2 4 5.58172 4 10C4 11.8919 4.40209 13.1304 5.5 14.5L12 22L18.5 14.5C19.5979 13.1304 20 11.8919 20 10C20 5.58172 16.4183 2 12 2Z"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                      <circle
                        cx="12"
                        cy="10"
                        r="3"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></circle>
                    </svg>
                  </div>
                  <div class="block-info-page">
                    <div class="top-title-contact-page">Visit us!</div>
                    {/* En una sola linea: Astro colapsa el salto entre
                        expresiones y "FL 33071" saldria pegado. */}
                    <address class="info-contact-page">
                      {NEGOCIO.calle},<br />{`${NEGOCIO.ciudad}, ${NEGOCIO.region} ${NEGOCIO.cp}`}
                    </address>
                  </div>
                </div>
              </li>

              <li class="list-item">
                <div class="block-icon-contact-page">
                  <div class="box-icon-contact">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="35"
                      height="35"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="ikonik-nemno"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M8 4H5C3.89543 4 3 4.89543 3 6V9M8 4H16M8 4V2M8 4V6M16 4H19C20.1046 4 21 4.89543 21 6V9H3M16 4V2M16 4V6M3 9V20C3 21.1046 3.89543 22 5 22H10M17 15.25V17L18.25 18.25M22 17C22 19.7614 19.7614 22 17 22C14.2386 22 12 19.7614 12 17C12 14.2386 14.2386 12 17 12C19.7614 12 22 14.2386 22 17Z"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </svg>
                  </div>
                  <div class="block-info-page">
                    <div class="top-title-contact-page">Opening hours</div>
                    <div class="info-contact-page">
                      {dias}<br />{horas ? `(${horas}` : ""}
                    </div>
                  </div>
                </div>
              </li>
            </ul>
          </div>

          {/* El formulario deja de estar escrito a mano aqui y pasa a <LeadForm>,
              el mismo componente que usan las 24 fichas de servicio.
          
              Habia DOS copias del contrato de Turnstile —los cuatro data- del widget,
              el honeypot `ref_id`, el campo `ts` y la carga en fachada— y dos copias
              de su script. Dos fuentes para un contrato de seguridad es una de mas:
              el dia que una se actualice y la otra no, el fallo es silencioso.
          
              Ademas esta copia tenia el reto DESPUES del boton de enviar y sin altura
              reservada. El componente lo pone antes (SC 2.4.3) y le reserva 65px. */}
          <LeadForm lang="en" />
        </div>
      </div>
    </section>
  </main>

  <Footer />

  {/* Dentro de <BaseLayout> a proposito: si va fuera, Astro lo emite DESPUES de
      </html>. Los navegadores lo ejecutan igual por recuperacion de errores,
      pero el HTML deja de ser valido. */}
</BaseLayout>

<style>
  /* Unico CSS nuevo de la ruta, y con alcance de pagina.
   *
   * El sitio original no tiene ni un solo checkbox, asi que el CSS portado no
   * trae NADA para ellos: sin esto la casilla y su texto legal salen apilados
   * en dos lineas y con el texto en negrita (webflow.css hace label{
   * display:block; font-weight:bold }). No es rediseno, es lo minimo para que
   * el bloque de consentimiento sea legible.
   */

  /* .form es flex column con align-items:center: sin width los hijos encogen. */
  .lead-consent {
    width: 100%;
    margin: 5px 0 10px;
  }

  .lead-consent-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 10px;
  }

  .lead-consent-row input[type="checkbox"] {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: var(--green-2);
  }

  .lead-consent-row label {
    margin-bottom: 0;
    font-weight: 400;
  }

  .lead-note {
    margin-bottom: 8px;
  }

  /* La direccion pasa de <div> a <address> (es el NAP del negocio, y la FASE 6
   * lo va a marcar). El UA pone font-style:italic en <address> y ni normalize
   * ni el CSS de Webflow lo resetean: sin esto la direccion sale en cursiva y
   * rompe la paridad con baseline/html/contact-us.html. */
  address.info-contact-page {
    font-style: normal;
  }

  /* .wrapper-contact-page es flex con align-items:flex-start, asi que la tarjeta
   * gris nunca se estira: su alto lo fija su contenido. La azul, en cambio, crece
   * por el bloque de consentimiento FTSA/TCPA (justificado por D4, no se acorta),
   * y acababa 447px por debajo de la gris: bajo la gris quedaba un hueco blanco
   * de casi 450px que se leia como un fallo de maquetacion.
   *
   * OJO, esto NO es literalmente el baseline: deja la gris en 1006px donde
   * produccion tenia 559. Se acepta a cambio de eliminar el hueco, porque la
   * alternativa era recortar copia legal, y eso no es maquetacion.
   *
   * A <=991px las tarjetas ya se apilan y no hace falta. */
  @media screen and (min-width: 992px) {
    .block-info-contact {
      align-self: stretch;
    }
  }

  /* La caja del reto sale VACIA del build (fachada) y se llena en el primer
   * foco. Reservar los 65px del widget evita que el boton de enviar salte hacia
   * abajo justo cuando la persona va a pulsarlo. Aqui el hueco se puede pagar
   * porque la tarjeta ya es alta; en el pie NO, y por eso alli no se reserva. */
  .lead-captcha {
    min-height: 65px;
    margin-bottom: 10px;
  }
</style>
