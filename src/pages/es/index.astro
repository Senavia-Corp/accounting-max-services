---
// Portada en espanol — /es
//
// ============================================================================
// ESTA RUTA, COMO LAS OTRAS 25 DE /es/, ESTA PUBLICADA. D3 se firmo el
// 2026-07-31 y con el se levantaron las CUATRO cosas, que iban juntas o
// ninguna:
//
//   sin <meta name="robots" content="noindex">   (se quito la prop `noindex`)
//   dentro del sitemap                           (filtro en astro.config.mjs)
//   hreflang reciproco en las dos direcciones    (BaseLayout.astro)
//   sin `Disallow: /es/`                         (public/robots.txt)
//
// Y el selector de idioma se pinta en las 54 rutas (ES_PUBLICO en i18n.ts).
//
// Por que iban juntas: publicar el selector sin hreflang es el error que Search
// Console reporta como «alternativa sin etiqueta de retorno», y un selector
// visible con noindex publica el espanol de facto igual — el noindex impide que
// Google lo indexe, no que una persona lo lea.
//
// LO QUE NO CAMBIO: el glosario de D3 sigue siendo la regla del contenido. IRS,
// Enrolled Agent, CPA, ITIN, EIN, LLC, S-Corp, W-2, 1099 y Notary Public NO se
// traducen nunca. «Enrolled Agent» o «CPA» traducidos son credenciales falsas y
// en Florida es infraccion que un notary se anuncie como «notario» en espanol.
// ============================================================================
//
// Espejo de src/pages/index.astro: misma estructura, mismas clases, mismo orden
// de secciones y los MISMOS componentes (Nav, Footer), con lang="es". Lo unico
// que cambia es de donde sale el texto: aqui de src/lib/i18n.ts (plantilla) y de
// los campos *Es de Sanity (contenido). Cero CSS nuevo.
//
// LOS SLUGS NO SE TRADUCEN: /es/services/notary-public-services, no
// /es/servicios/... La politica y sus tres razones estan en src/lib/es.ts.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { servicios, testimonios, sanity, NEGOCIO } from "../../lib/sanity";
import { t, interpola } from "../../lib/i18n";
import { requiereEs, enlace } from "../../lib/es";
import JsonLd from "../../components/JsonLd.astro";
import { agrupar } from "../../lib/familias";

const lang = "es" as const;
const c = t(lang);

const MEDIOS = [
  "6658e5a9a386bf0eb1b0c6a0-main-picture.jpg",
  "66591cff761a876e791ad585-1.png",
  "66591defc9bd4c2b2a6fd8c8-2.png",
  "66591fc962e8774f9117068b-3.png",
  "6785bf353063de8bcbcf3dfc-icon-13.svg",
  "684a14073e3e3c127cc2a314-logo-google-reviews.svg",
  "684a14073e3e3c127cc2a315-starts.svg",
  "684a15893000dfa033be0899-684a120d78059a4010848353-arow.svg",
];

type Asset = { originalFilename: string; url: string; w: number; h: number };

const g = globalThis as any;
const assets: Asset[] = await (g.__amsMediosPortada ??= sanity.fetch(
  `*[_type == "sanity.imageAsset" && originalFilename in $f]{
     originalFilename, url,
     "w": metadata.dimensions.width,
     "h": metadata.dimensions.height
   }`,
  { f: MEDIOS },
));

/** Falla en voz alta: una imagen rota en la portada es la primera impresion. */
const img = (nombre: string): Asset => {
  const a = assets.find((x) => x.originalFilename === nombre);
  if (!a) throw new Error(`Falta en Sanity el asset "${nombre}" (portada ES).`);
  return a;
};

const hero = img("6658e5a9a386bf0eb1b0c6a0-main-picture.jpg");
const feat1 = img("66591cff761a876e791ad585-1.png");
const feat2 = img("66591defc9bd4c2b2a6fd8c8-2.png");
const feat3 = img("66591fc962e8774f9117068b-3.png");
const iconCta = img("6785bf353063de8bcbcf3dfc-icon-13.svg");
const iconGoogle = img("684a14073e3e3c127cc2a314-logo-google-reviews.svg");
const iconEstrellas = img("684a14073e3e3c127cc2a315-starts.svg");
const flecha = img("684a15893000dfa033be0899-684a120d78059a4010848353-arow.svg");

// Transformaciones de Sanity. Prohibido AVIF, y por eso `fm=webp` y NO
// `auto=format`: `auto=format` no fija formato, negocia por la cabecera
// `Accept`, y Chrome pide `image/avif` primero — asi que el CDN devolvia AVIF.
// `fm=webp` fuerza WebP sea cual sea el navegador. Los SVG no pasan por aqui
// (se sirven crudos): `fm=webp` los rasterizaria.
const src = (a: Asset, w: number) => `${a.url}?w=${w}&q=75&fm=webp`;
const srcset = (a: Asset, ws: number[]) => ws.map((w) => `${src(a, w)} ${w}w`).join(", ");

// Los DOCE y con el mismo criterio de orden que la portada EN (destacados
// primero, luego el orden de la coleccion). Ver el porque alli.
const servs = await (g.__amsServicios ??= servicios());
if (servs.length !== 12) {
  throw new Error(`Se esperaban 12 servicios, hay ${servs.length}.`);
}
// FASE 2: los 12 en 3 familias, igual que la portada EN. El agrupado va por
// slug (src/lib/familias.ts), que es el mismo en las dos lenguas: /es hereda
// el reparto sin duplicarlo y sin poder divergir.
const familias = agrupar(servs);

// Los 20 testimonios se muestran TAL CUAL: son palabras de clientes reales, no
// se traducen ni se editan (regla de FASE 5). El unico texto que cambia a su
// alrededor son los rotulos de la interfaz. D5 sigue vigente: prohibido JSON-LD
// Review o aggregateRating, tambien aqui.
const opiniones = await testimonios();

// Titulo real del video en YouTube: es el nombre de una obra de un tercero y
// esta en ingles. No se traduce en ninguna de las dos rutas (R3).
const VIDEO = {
  id: "Nx4HDJ-TZn4",
  titulo: c.home.videoTitulo,
  miniatura: "https://i.ytimg.com/vi/Nx4HDJ-TZn4/maxresdefault.jpg",
};

const CONTACTO = enlace(lang, "/contact-us");
const SOBRE = enlace(lang, "/about-us");

// {negocio} = NEGOCIO.nombre: es NAP y va literal en las dos lenguas.
const TITULO = interpola(c.meta.plantillaTitulo, {
  pagina: c.meta.homeTitle,
  negocio: NEGOCIO.nombre,
});
---

<BaseLayout title={TITULO} description={c.meta.homeDescription} lang={lang}>
  <JsonLd tipo="home" nombre={TITULO} descripcion={c.meta.homeDescription} faq={c.faq.items} />
  <Nav lang={lang} />

  <main id="main">
    {/* ================================================================ HERO */}
    {/* FASE 2 — espejo exacto de src/pages/index.astro. Todo el texto sale de
        i18n.ts, asi que las dos portadas no pueden divergir. */}
    <section class="hero">
      <div class="contenido">
        <div class="hero__rejilla">
          <div>
            <ul class="hero__credenciales">
              {c.home.confianza.map((x) => <li>{x.fuerte}</li>)}
            </ul>
            <h1 class="hero__titulo"><strong>{c.home.heroTitle}</strong></h1>
            <p class="hero__entrada">{c.home.heroIntro}</p>
            <div class="hero__acciones">
              <a href={CONTACTO} class="boton boton--principal">{c.home.heroCta}</a>
              <a href={NEGOCIO.telefonoHref} class="boton boton--secundario">
                {interpola(c.home.cierreLlamar, { telefono: NEGOCIO.telefono })}
              </a>
            </div>
          </div>
          <img
            src={src(hero, 1080)}
            srcset={srcset(hero, [500, 800, 1080, 1600])}
            sizes="(max-width: 62rem) 100vw, 45vw"
            width={hero.w}
            height={hero.h}
            alt={c.home.heroAlt}
            loading="eager"
            decoding="async"
            class="hero__foto"
          />
        </div>
      </div>
    </section>

    {/* ========================================================== CONFIANZA */}
    <section class="seccion seccion--corta" aria-label="Credenciales">
      <div class="contenido">
        <ul class="confianza revelar">
          {
            c.home.confianza.map((x) => (
              <li class="confianza__item">
                <span class="confianza__fuerte">{x.fuerte}</span>
                <span class="confianza__suave">{x.suave}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* =========================================================== SERVICIOS */}
    <section class="seccion seccion--alterna" aria-labelledby="servicios-titulo">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="servicios-titulo">{c.home.familiasTitulo}</h2>
          <p>{c.home.familiasIntro}</p>
        </div>
        <div class="familias">
          {
            familias.map((grupo, i) => (
              <article class="familia revelar">
                <span class="familia__numero">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="familia__nombre">{c.home.familias[i].nombre}</h3>
                <p class="familia__resumen">{c.home.familias[i].resumen}</p>
                <ul class="familia__lista">
                  {grupo.map((s) => (
                    <li>
                      <a href={enlace(lang, `/services/${s.slug}`)} class="familia__enlace">
                        {(s.titleEs || s.title).trim()}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>


    {/* ============================================================ ABOUT-US */}
    {/* FASE 2: mismas piezas (video + credenciales), clases propias. La caja
        16:9 la da `aspect-ratio` en vez del padding-top en linea que heredaba
        de .w-embed-youtubevideo — un truco de cuando aspect-ratio no existia.
        La fachada click-to-load NO se toca: sigue evitando ~700 KB y las
        cookies de Google en la primera visita. */}
    <section class="seccion" aria-labelledby="about-titulo">
      <div class="contenido">
        <div class="sobre">
          <div class="sobre__video" data-yt-caja>
            <button
              type="button"
              class="yt-facade"
              data-yt-id={VIDEO.id}
              data-yt-titulo={VIDEO.titulo}
              aria-label={interpola(c.home.videoCta, { titulo: VIDEO.titulo })}
            >
              <img
                src={VIDEO.miniatura}
                width="1280"
                height="720"
                alt=""
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <svg class="yt-play" viewBox="0 0 68 48" aria-hidden="true" focusable="false">
                <path
                  d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2 0 34 0 34 0S12.8 0 7.5 1.7a8.5 8.5 0 0 0-6 6A88.6 88.6 0 0 0 0 24a88.6 88.6 0 0 0 1.5 16.3 8.5 8.5 0 0 0 6 6C12.8 48 34 48 34 48s21.2 0 26.5-1.7a8.5 8.5 0 0 0 6-6A88.6 88.6 0 0 0 68 24a88.6 88.6 0 0 0-1.5-16.3z"
                  fill="#212121"
                  fill-opacity="0.8"></path>
                <path d="M27 34V14l18 10-18 10z" fill="#fff"></path>
              </svg>
            </button>
          </div>
          <div class="sobre__texto">
            <h2 id="about-titulo">{c.home.aboutTitle}</h2>
            <p set:html={c.home.aboutHtml} />
            <a href={SOBRE} class="boton boton--secundario">{c.home.aboutCta}</a>
          </div>
        </div>
      </div>
    </section>


    {/* ============================================================= PROCESO */}
    <section class="seccion" aria-labelledby="proceso-titulo">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="proceso-titulo">{c.home.procesoTitulo}</h2>
        </div>
        <ol class="proceso">
          {
            c.home.procesoPasos.map((paso) => (
              <li class="proceso__paso revelar">
                <h3 class="proceso__titulo">{paso.titulo}</h3>
                <p class="proceso__texto">{paso.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ========================================================= TESTIMONIOS */}
    {/* Los 20 testimonios NO se traducen: son palabras de clientes reales
        (regla de FASE 5, y D5 sigue prohibiendo JSON-LD Review). */}
    <section class="seccion seccion--alterna" aria-labelledby="reviews-titulo">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="reviews-titulo">{c.reviews.title}</h2>
          <p>{c.reviews.text}</p>
        </div>
        <div
          class="testimonios"
          data-carrusel
          tabindex="0"
          role="group"
          aria-labelledby="reviews-titulo"
        >
          {
            opiniones.map((o) => (
              <figure class="testimonio">
                <blockquote class="testimonio__texto">{o.quote}</blockquote>
                <figcaption>
                  <div class="testimonio__autor">{o.author}</div>
                  <div class="testimonio__fuente">{c.reviews.publicado}</div>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="carrusel__mandos">
          <button type="button" class="carrusel__boton" data-carrusel-prev aria-label={c.reviews.prev}>
            &#8592;
          </button>
          <button type="button" class="carrusel__boton" data-carrusel-next aria-label={c.reviews.next}>
            &#8594;
          </button>
        </div>
      </div>
    </section>

    {/* ============================================================ FEATURES */}
    <section class="seccion" aria-labelledby="features-titulo">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="features-titulo">{c.features.title}</h2>
          <p>{c.features.text}</p>
        </div>
        <div class="familias">
          {
            [feat1, feat3, feat2].map((im, i) => (
              <article class="familia revelar">
                <img
                  src={src(im, 800)}
                  srcset={srcset(im, [500, 800, im.w])}
                  sizes="(max-width: 62rem) 100vw, 30vw"
                  width={im.w}
                  height={im.h}
                  alt={c.home.featuresAlt[i]}
                  loading="lazy"
                  decoding="async"
                  style="width:100%;height:auto;border-radius:var(--radio-control)"
                />
                <h3 class="familia__nombre">{c.features.items[i].title}</h3>
                <p class="familia__resumen" set:html={c.features.items[i].html} />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ================================================================= FAQ */}
    <section class="seccion seccion--alterna" aria-labelledby="faq-titulo">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="faq-titulo">{c.faq.title}</h2>
        </div>
        <div class="faq-lista">
          {
            c.faq.items.map((item) => (
              <details class="faq-item">
                <summary class="faq-item__titulo">{item.q}</summary>
                <p class="faq-item__cuerpo">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* ============================================================== CIERRE */}
    <section class="seccion seccion--oscura" aria-labelledby="cierre-titulo">
      <div class="contenido">
        <div class="cierre">
          <div class="cierre__texto">
            <h2 id="cierre-titulo">{c.home.cierreTitulo}</h2>
            <p>{c.home.cierreTexto}</p>
          </div>
          <div class="cierre__acciones">
            <a href={CONTACTO} class="boton boton--principal">{c.home.heroCta}</a>
            <a href={NEGOCIO.telefonoHref} class="boton boton--secundario">
              {interpola(c.home.cierreLlamar, { telefono: NEGOCIO.telefono })}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  /* Identico al de la ruta EN: la facade del video no existe en el port de
   * Webflow porque en produccion no habia facade. Alcance de componente. */
  .yt-facade {
    cursor: pointer;
    background: none;
    border: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    display: block;
    position: absolute;
    inset: 0;
  }

  .yt-facade img {
    object-fit: cover;
    width: 100%;
    height: 100%;
    display: block;
  }

  .yt-play {
    width: 68px;
    height: 48px;
    transition: opacity 0.2s;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .yt-facade:hover .yt-play,
  .yt-facade:focus-visible .yt-play {
    opacity: 0.75;
  }

  /* Anillo de foco HACIA DENTRO, igual que en la ruta EN. El global de site.css
   * se pinta entero FUERA de la caja (outline a offset +2px y box-shadow de 4px
   * de extension), y este boton mide exactamente lo mismo que su contenedor
   * .w-embed-youtubevideo, que lleva overflow:hidden: el anillo se recortaba al
   * 100% y el unico indicador que quedaba era la bajada de opacidad del
   * triangulo, IDENTICA a la de :hover. Un usuario de teclado no distinguia
   * foco de raton (SC 2.4.7 y 2.4.11). Se conservan los dos tonos del global.
   *
   * La banda navy va en un ::after y no en un `box-shadow: inset` del propio
   * boton porque la miniatura cubre el 100% de la caja y taparia la sombra: un
   * pseudoelemento posicionado si se pinta por encima del contenido en flujo.
   * La banda blanca es el `outline` del boton, con offset NEGATIVO. */
  .yt-facade:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: -4px;
    box-shadow: none;
  }

  .yt-facade:focus-visible::after {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    /* Solo 2px: la banda navy ocupa 0-2px y la blanca del outline 2-4px, sin
     * solaparse. Con 4px aqui el ::after tapaba el outline (Chrome pinta el
     * pseudoelemento posicionado por encima) y el anillo salia de un solo tono. */
    box-shadow: inset 0 0 0 2px var(--bllue);
  }
</style>

<script>
  // Facade del video. Mismo comportamiento que en la ruta EN: youtube-nocookie
  // y no youtube.com porque no hay politica de privacidad publicada (D4).
  const boton = document.querySelector<HTMLButtonElement>("button.yt-facade");
  const caja = boton?.closest<HTMLElement>("[data-yt-caja]");

  if (boton && caja) {
    boton.addEventListener(
      "click",
      () => {
        const marco = document.createElement("iframe");
        marco.src =
          `https://www.youtube-nocookie.com/embed/${boton.dataset.ytId}` +
          "?rel=0&controls=1&autoplay=1&mute=0&start=0";
        marco.title = boton.dataset.ytTitulo ?? "";
        // `fullscreen` va SOLO dentro de allow. Con el atributo legacy
        // allowFullscreen ademas, Chrome avisa por consola en cada clic
        // ("Allow attribute will take precedence over 'allowfullscreen'") y lo
        // ignora igual, asi que sobra.
        marco.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
        marco.style.cssText =
          "position:absolute;left:0;top:0;width:100%;height:100%;border:0";
        caja.replaceChild(marco, boton);
        marco.focus();
      },
      { once: true },
    );
  }
</script>
