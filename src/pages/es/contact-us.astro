---
// Contacto en espanol — /es/contact-us
//
// D3 firmado el 2026-07-31: esta ruta se indexa, entra en el sitemap y lleva
// hreflang reciproco. La explicacion completa esta en src/pages/es/index.astro.
//
// Espejo de src/pages/contact-us.astro: mismo marcado, mismos SVG, mismo
// contrato de campos contra /api/lead. Solo cambia el idioma de los rotulos.
//
// EL NAP NO PASA POR EL TRADUCTOR. Telefono, correo, direccion y horario salen
// de NEGOCIO (src/lib/sanity.ts) y se pintan IDENTICOS en las dos lenguas,
// incluido "Monday - Friday (8:00 AM - 5:00 PM)". Traducir el horario crearia
// una segunda version del NAP que un dia diverge de la de Google Business.
//
// CONSENTIMIENTO FTSA + TCPA. Las dos casillas siguen siendo separadas por
// canal, opcionales y sin marcar. El texto legal esta traducido, no reescrito:
// no se anade ni se quita ninguna condicion respecto al ingles, porque el
// consentimiento que se recoge tiene que ser el mismo en las dos lenguas.
// "STOP" y "HELP" van literales: son las palabras clave que hay que teclear.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { NEGOCIO } from "../../lib/sanity";
import { t, interpola } from "../../lib/i18n";
import { SITE_KEY } from "../../lib/turnstile";

const lang = "es" as const;
const c = t(lang);

// El horario vive en NEGOCIO como una sola cadena; aqui va en dos lineas, igual
// que en produccion. Se parte, no se traduce ni se reescribe.
const [dias, horas] = NEGOCIO.horario.split(" (");

/**
 * Marca de tiempo para el time-trap del servidor. Igual que en la ruta EN: la
 * pagina es estatica, asi que este valor es la hora del BUILD y el <script> de
 * abajo lo sobreescribe con Date.now() al cargar.
 */
const TS_BUILD = Date.now();

// {negocio} = NEGOCIO.nombre, que es NAP y va literal en las dos lenguas.
const CONSENT_LLAMADAS = interpola(c.form.consentCalls, { negocio: NEGOCIO.nombre });
const CONSENT_SMS = interpola(c.form.consentSms, { negocio: NEGOCIO.nombre });

const TITULO = interpola(c.meta.plantillaTitulo, {
  pagina: c.meta.contactTitle,
  negocio: NEGOCIO.nombre,
});
---

<BaseLayout title={TITULO} description={c.meta.contactDescription} lang={lang}>
  <Nav lang={lang} />

  <main id="main">
    <section class="header-contact-page">
      <div class="w-layout-blockcontainer container w-container">
        <div class="wrapper-contact-page">
          <div class="block-info-contact">
            <h1 class="h1">{c.contact.title}</h1>
            <div>{c.contact.intro}</div>

            <ul role="list" class="list">
              <li class="list-item">
                <a href={NEGOCIO.telefonoHref} class="block-icon-contact-page w-inline-block">
                  <div class="box-icon-contact">
                    {/* Iconos decorativos: el texto de al lado ya los nombra. */}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="35"
                      height="35"
                      viewBox="0 0 24 24"
                      class="ikonik-122hk"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="currentColor"
                        d="M15.795 6.791 13.005 4v6.995H20l-2.791-2.79 4.503-4.503-1.414-1.414z"></path>
                      <path
                        fill="currentColor"
                        d="M16.712 13.288a.999.999 0 0 0-1.414 0l-1.597 1.596c-.824-.245-2.166-.771-2.99-1.596-.874-.874-1.374-2.253-1.594-2.992l1.594-1.594a.999.999 0 0 0 0-1.414l-4-4a1.03 1.03 0 0 0-1.414 0l-2.709 2.71c-.382.38-.597.904-.588 1.437.022 1.423.396 6.367 4.297 10.268C10.195 21.6 15.142 21.977 16.566 22h.028c.528 0 1.027-.208 1.405-.586l2.712-2.712a.999.999 0 0 0 0-1.414l-3.999-4zM16.585 20c-1.248-.021-5.518-.356-8.874-3.712C4.343 12.92 4.019 8.636 4 7.414l2.004-2.005L8.59 7.995 7.297 9.288c-.238.238-.34.582-.271.912.024.115.611 2.842 2.271 4.502s4.387 2.247 4.502 2.271a.994.994 0 0 0 .912-.271l1.293-1.293 2.586 2.586L16.585 20z"
                      ></path>
                    </svg>
                  </div>
                  <div class="block-info-page">
                    <div class="top-title-contact-page">{c.contact.telefonoLabel}</div>
                    {/* NAP: no pasa por el traductor. */}
                    <div class="info-contact-page">{NEGOCIO.telefono}</div>
                  </div>
                </a>
              </li>

              <li class="list-item">
                <a href={`mailto:${NEGOCIO.email}`} class="block-icon-contact-page w-inline-block">
                  <div class="box-icon-contact">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="35"
                      height="35"
                      viewBox="0 0 1024 1024"
                      class="ikonik-dn3cw"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="currentColor"
                        d="M928 160H96c-17.7 0-32 14.3-32 32v640c0 17.7 14.3 32 32 32h832c17.7 0 32-14.3 32-32V192c0-17.7-14.3-32-32-32zm-40 110.8V792H136V270.8l-27.6-21.5 39.3-50.5 42.8 33.3h643.1l42.8-33.3 39.3 50.5-27.7 21.5zM833.6 232L512 482 190.4 232l-42.8-33.3-39.3 50.5 27.6 21.5 341.6 265.6a55.99 55.99 0 0 0 68.7 0L888 270.8l27.6-21.5-39.3-50.5-42.7 33.2z"
                      ></path>
                    </svg>
                  </div>
                  <div class="block-info-page">
                    <div class="top-title-contact-page">{c.contact.emailLabel}</div>
                    <div class="info-contact-page">{NEGOCIO.email}</div>
                  </div>
                </a>
              </li>

              {/* Direccion y horario eran <a href="#"> en produccion. Aqui, como
                  en la ruta EN, dejan de ser enlaces: no se inventa una URL de
                  Google Maps (R3). */}
              <li class="list-item">
                <div class="block-icon-contact-page">
                  <div class="box-icon-contact">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="35"
                      height="35"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="ikonik-1cr66"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M12 2C7.58172 2 4 5.58172 4 10C4 11.8919 4.40209 13.1304 5.5 14.5L12 22L18.5 14.5C19.5979 13.1304 20 11.8919 20 10C20 5.58172 16.4183 2 12 2Z"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                      <circle
                        cx="12"
                        cy="10"
                        r="3"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></circle>
                    </svg>
                  </div>
                  <div class="block-info-page">
                    <div class="top-title-contact-page">{c.contact.direccionLabel}</div>
                    {/* En una sola linea: Astro colapsa el salto entre
                        expresiones y "FL 33071" saldria pegado. */}
                    <address class="info-contact-page">
                      {NEGOCIO.calle},<br />{`${NEGOCIO.ciudad}, ${NEGOCIO.region} ${NEGOCIO.cp}`}
                    </address>
                  </div>
                </div>
              </li>

              <li class="list-item">
                <div class="block-icon-contact-page">
                  <div class="box-icon-contact">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="35"
                      height="35"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="ikonik-nemno"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M8 4H5C3.89543 4 3 4.89543 3 6V9M8 4H16M8 4V2M8 4V6M16 4H19C20.1046 4 21 4.89543 21 6V9H3M16 4V2M16 4V6M3 9V20C3 21.1046 3.89543 22 5 22H10M17 15.25V17L18.25 18.25M22 17C22 19.7614 19.7614 22 17 22C14.2386 22 12 19.7614 12 17C12 14.2386 14.2386 12 17 12C19.7614 12 22 14.2386 22 17Z"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </svg>
                  </div>
                  <div class="block-info-page">
                    <div class="top-title-contact-page">{c.contact.horarioLabel}</div>
                    {/* El horario es NAP: sale de NEGOCIO y va en ingles en las
                        dos lenguas, igual que el telefono. */}
                    <div class="info-contact-page">
                      {dias}<br />{horas ? `(${horas}` : ""}
                    </div>
                  </div>
                </div>
              </li>
            </ul>
          </div>

          <div class="block-form-contact">
            <div class="wrapper-form-page">
              <div class="block-form">
                <div class="form-block-contact w-form">
                  <div class="header-form">
                    <h2 class="h2">{c.form.title}</h2>
                    <div>{c.form.text}</div>
                  </div>

                  {/*
                    Mismo contrato de campos que la ruta EN — /api/lead no sabe
                    de idiomas y los `name` NO se traducen:
                      full_name (req) · email (req) · phone (req) · message
                      consent_calls / consent_sms  -> "yes" o ausentes
                      ref_id -> honeypot
                      ts     -> ver TS_BUILD arriba
                  */}
                  {/* Sin JS el formulario se OCULTA (ver el <noscript> de
                      BaseLayout): sin token de captcha el endpoint responde 403. */}
                  <noscript>
                    <p class="small-text lead-note">
                      {interpola(c.form.sinJs, { telefono: NEGOCIO.telefono, email: NEGOCIO.email })}
                    </p>
                  </noscript>
                  <form
                    id="lead-form"
                    class="form"
                    method="post"
                    action="/api/lead"
                    data-captcha-error={c.errores.captcha}
                  >
                    <label class="visually-hidden" for="lead-full-name">
                      {c.form.fullNameLabel}
                    </label>
                    <input
                      id="lead-full-name"
                      class="text-field-form w-input"
                      type="text"
                      name="full_name"
                      maxlength="256"
                      placeholder={c.form.fullNamePlaceholder}
                      autocomplete="name"
                      required
                    />

                    <label class="visually-hidden" for="lead-email">{c.form.emailLabel}</label>
                    <input
                      id="lead-email"
                      class="text-field-form w-input"
                      type="email"
                      name="email"
                      maxlength="256"
                      placeholder={c.form.emailPlaceholder}
                      autocomplete="email"
                      required
                    />

                    <label class="visually-hidden" for="lead-phone">{c.form.phoneLabel}</label>
                    <input
                      id="lead-phone"
                      class="text-field-form w-input"
                      type="tel"
                      name="phone"
                      maxlength="256"
                      placeholder={c.form.phonePlaceholder}
                      autocomplete="tel"
                      required
                    />

                    <label class="visually-hidden" for="lead-message">{c.form.messageLabel}</label>
                    <textarea
                      id="lead-message"
                      class="text-field-form large w-input"
                      name="message"
                      maxlength="5000"
                      placeholder={c.form.messagePlaceholder}></textarea>

                    {/*
                      FTSA (Florida Telephone Solicitation Act) + TCPA. El
                      telefono es obligatorio en este formulario, asi que hace
                      falta consentimiento expreso, por escrito y SEPARADO POR
                      CANAL antes de llamar o mandar SMS automatizados.
                      Las dos casillas son opcionales y salen sin marcar: atar
                      el presupuesto a que acepten que les llamen invalida el
                      consentimiento. En primera persona porque es la
                      declaracion del propio usuario, igual que en ingles.
                    */}
                    <fieldset class="lead-consent">
                      <legend class="visually-hidden">{c.form.consentLegend}</legend>

                      <div class="lead-consent-row">
                        <input
                          id="lead-consent-calls"
                          type="checkbox"
                          name="consent_calls"
                          value="yes"
                        />
                        <label class="small-text" for="lead-consent-calls">
                          {CONSENT_LLAMADAS}
                        </label>
                      </div>

                      <div class="lead-consent-row">
                        <input
                          id="lead-consent-sms"
                          type="checkbox"
                          name="consent_sms"
                          value="yes"
                        />
                        {/* STOP y HELP van literales: son las palabras que hay
                            que teclear para darse de baja o pedir ayuda. */}
                        <label class="small-text" for="lead-consent-sms">{CONSENT_SMS}</label>
                      </div>

                      <p class="small-text lead-note">{c.form.consentNote}</p>

                      {/*
                        D4: la politica de privacidad y el aviso GLBA no existen
                        todavia. El hueco va visible tambien en espanol; no se
                        redacta de relleno ni se enlaza a nada (R3).
                      */}
                      {/* Enlaza a la version EN a proposito: no existe
                          /es/privacy-policy y traducir un aviso GLBA sin un
                          revisor cualificado que lo firme es exactamente el
                          riesgo que D4 impide asumir. Mejor un enlace
                          honesto en ingles que un documento legal traducido a
                          ojo. Se marca con hreflang="en". */}
                      <p class="small-text lead-note">
                        {c.form.privacyBefore}<a href="/privacy-policy" hreflang="en">{c.form.privacyLink}</a>{c.form.privacyAfter}
                      </p>
                    </fieldset>

                    {/* Trampa anti-bots. El `name` no se traduce. */}
                    <div class="visually-hidden" aria-hidden="true">
                      <label for="lead-ref-id">{c.form.honeypot}</label>
                      <input
                        id="lead-ref-id"
                        type="text"
                        name="ref_id"
                        tabindex="-1"
                        autocomplete="off"
                      />
                    </div>

                    <input id="lead-ts" type="hidden" name="ts" value={TS_BUILD} />

                    {/* `lang` explicito: idiomaDe() de /api/lead lo prefiere al
                        Referer, y de el depende que el error salga en espanol. */}
                    <input type="hidden" name="lang" value="es" />

                    {/* Turnstile, justo antes del boton para que el reto quede
                        antes que enviar en el orden de tabulacion. La caja sale
                        VACIA del build: la pinta scripts/turnstile.ts al primer
                        foco (fachada). */}
                    {SITE_KEY && (
                      <div
                        class="lead-captcha"
                        data-turnstile
                        data-sitekey={SITE_KEY}
                        data-lang="es"
                        data-theme="light"
                      >
                      </div>
                    )}

                    <input
                      type="submit"
                      class="button w-button"
                      data-wait={c.form.wait}
                      value={c.form.submit}
                    />
                  </form>

                  <div
                    class="success-message w-form-done"
                    role="status"
                    tabindex="-1"
                    data-lead-done
                  >
                    <svg
                      class="icon-check"
                      width="100"
                      height="100"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <circle cx="12" cy="12" r="10" fill="var(--green-2)"></circle>
                      <path
                        d="m7.5 12.4 3 3 6-6.6"
                        stroke="#fff"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </svg>
                    <div class="title-form">{c.form.done}</div>
                  </div>

                  <div class="w-form-fail" role="alert" tabindex="-1" data-lead-fail>
                    <div>{c.form.fail}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />

  {/* Dentro de <BaseLayout> a proposito: fuera, Astro lo emite despues de
      </html> y el HTML deja de ser valido. */}
  <script>
    import { armarCaptcha, tokenCaptcha, reiniciarCaptcha } from "../../scripts/turnstile";

    // Mejora progresiva del envio. Identico al de la ruta EN salvo que el
    // rotulo de espera sale de data-wait: el <script> se compila aparte y no ve
    // el frontmatter, asi que sin ese atributo diria "Please wait..." en /es/.
    const form = document.getElementById("lead-form") as HTMLFormElement | null;
    const bloque = form?.closest(".form-block-contact") as HTMLElement | null;
    const hecho = bloque?.querySelector<HTMLElement>("[data-lead-done]");
    const fallo = bloque?.querySelector<HTMLElement>("[data-lead-fail]");
    const enviar = form?.querySelector<HTMLInputElement>('input[type="submit"]');
    const marca = form?.querySelector<HTMLInputElement>("#lead-ts");

    // La pagina es estatica: el value que viaja en el HTML es la hora del BUILD.
    if (marca) marca.value = String(Date.now());

    if (form && hecho && fallo && enviar) {
      const etiqueta = enviar.value;
      const espera = enviar.dataset.wait ?? etiqueta;

      // El texto se escribe ANTES de mostrar y enfocar: role="alert" + focus()
      // anuncia lo que hay en ese instante. textContent y NUNCA innerHTML.
      const mostrar = (el: HTMLElement, texto = "") => {
        if (texto) (el.firstElementChild ?? el).textContent = texto;
        el.style.display = "block";
        el.focus();
      };
      const ocultar = (el: HTMLElement) => {
        el.style.display = "";
      };

      // Fachada: nada de challenges.cloudflare.com hasta el primer foco.
      armarCaptcha(form);

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        ocultar(fallo);

        enviar.disabled = true;
        enviar.value = espera;

        let motivo = "";
        try {
          // El servidor responde 403 sin token: se espera al reto ANTES de
          // gastar un intento del limite por IP.
          const cf = await tokenCaptcha(form).catch(() => {
            motivo = form.dataset.captchaError ?? "";
            throw new Error("captcha");
          });
          const datos = new FormData(form);
          if (cf) datos.set("cf-turnstile-response", cf);

          const res = await fetch(form.action, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: datos,
          });
          if (!res.ok) {
            const cuerpo = await res.json().catch(() => null);
            if (typeof cuerpo?.error === "string" && cuerpo.error) motivo = cuerpo.error;
            throw new Error(String(res.status));
          }
          form.style.display = "none";
          mostrar(hecho);
        } catch {
          // El token es de un solo uso: si el servidor llego a verificarlo, el
          // siguiente envio con el mismo token da "timeout-or-duplicate".
          reiniciarCaptcha(form);
          mostrar(fallo, motivo);
        } finally {
          enviar.disabled = false;
          enviar.value = etiqueta;
        }
      });
    }
  </script>
</BaseLayout>

<style>
  /* Identico al de la ruta EN: el sitio original no tiene ni un checkbox, asi
   * que el CSS portado no trae nada para ellos. No es rediseno, es lo minimo
   * para que el bloque de consentimiento sea legible. */
  .lead-consent {
    width: 100%;
    margin: 5px 0 10px;
  }

  .lead-consent-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 10px;
  }

  .lead-consent-row input[type="checkbox"] {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: var(--green-2);
  }

  .lead-consent-row label {
    margin-bottom: 0;
    font-weight: 400;
  }

  .lead-note {
    margin-bottom: 8px;
  }

  /* El UA pone font-style:italic en <address> y ni normalize ni el CSS de
   * Webflow lo resetean. */
  address.info-contact-page {
    font-style: normal;
  }

  /* Identico al de la ruta EN. .wrapper-contact-page es flex con
   * align-items:flex-start, asi que la tarjeta gris no se estira mientras la azul
   * crece por el bloque de consentimiento FTSA/TCPA (D4, no se acorta): en ES
   * acababa 476px por debajo, con ese hueco blanco bajo la gris.
   * NO es literalmente el baseline —la gris pasa de 609 a 1085px—, y se acepta:
   * la alternativa era recortar copia legal. A <=991px ya se apilan. */
  @media screen and (min-width: 992px) {
    .block-info-contact {
      align-self: stretch;
    }
  }

  /* La caja del reto sale VACIA del build (fachada) y se llena al primer foco.
   * Reservar los 65px evita que el boton salte cuando se va a pulsar. */
  .lead-captcha {
    min-height: 65px;
    margin-bottom: 10px;
  }
</style>
