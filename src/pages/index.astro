---
// Portada.
//
// Estructura y clases copiadas VERBATIM de baseline/html/index.html, en el
// mismo orden: header · bar-services · about-us · reviews · features ·
// call-action · faq. El cromo (menu y pie) lo ponen Nav y Footer.
//
// Los datos salen de Sanity; los textos de seccion son los de produccion, sin
// reescribir (R3). Cero CSS nuevo salvo la facade del video, que no existe en
// el port de Webflow porque en produccion no habia facade.
//
// Diferencias deliberadas respecto al HTML de produccion, todas justificadas
// abajo en su sitio:
//   - Fuera los `data-w-id` y los `style="opacity:0"` de las interacciones de
//     Webflow. Sin webflow.js esos inline styles dejan el H1, el bloque de
//     "about" y el titulo del FAQ INVISIBLES para siempre.
//   - Fuera el `style="height:0px"` del panel de FAQ, por lo mismo: sin JS el
//     acordeon se queda cerrado y el contenido inalcanzable.
//   - El acordeon pasa de <a href="#"> a <button type="button">.
//   - Las flechas del carrusel pasan de <div> a <button type="button">.
//   - El <iframe> de YouTube pasa a facade click-to-load.
//   - Fuera el <div class="w-embed"><style>…</style></div> de .reviews: esas
//     cuatro reglas (.corner-top-1/2, .corner-bottom-1/2) ya estan en el CSS
//     portado (accounting-max.webflow.css:1386-1417).
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import { servicios, testimonios, sanity, NEGOCIO } from "../lib/sanity";
import { agrupar } from "../lib/familias";
import { t, interpola } from "../lib/i18n";

// FASE 2: el texto de las secciones nuevas sale de i18n.ts, no de literales
// en la pagina. Es lo que impide que /es se quede atras: el tipo `Cadenas`
// obliga a que la clave exista en las dos lenguas o el build falla.
const c = t("en");

// Assets sueltos en Sanity (sin documento que los referencie). Se piden por
// nombre original en una sola consulta, igual que hacen Nav y Footer.
const MEDIOS = [
  "6658e5a9a386bf0eb1b0c6a0-main-picture.jpg",
  "66591cff761a876e791ad585-1.png",
  "66591defc9bd4c2b2a6fd8c8-2.png",
  "66591fc962e8774f9117068b-3.png",
  "6785bf353063de8bcbcf3dfc-icon-13.svg",
  "684a14073e3e3c127cc2a314-logo-google-reviews.svg",
  "684a14073e3e3c127cc2a315-starts.svg",
  "684a15893000dfa033be0899-684a120d78059a4010848353-arow.svg",
];

type Asset = { originalFilename: string; url: string; w: number; h: number };

const g = globalThis as any;
const assets: Asset[] = await sanity.fetch(
  `*[_type == "sanity.imageAsset" && originalFilename in $f]{
     originalFilename, url,
     "w": metadata.dimensions.width,
     "h": metadata.dimensions.height
   }`,
  { f: MEDIOS },
);

/** Falla en voz alta: una imagen rota en la portada es la primera impresion. */
const img = (nombre: string): Asset => {
  const a = assets.find((x) => x.originalFilename === nombre);
  if (!a) throw new Error(`Falta en Sanity el asset "${nombre}" (portada).`);
  return a;
};

const hero = img("6658e5a9a386bf0eb1b0c6a0-main-picture.jpg");
const feat1 = img("66591cff761a876e791ad585-1.png");
const feat2 = img("66591defc9bd4c2b2a6fd8c8-2.png");
const feat3 = img("66591fc962e8774f9117068b-3.png");
const iconCta = img("6785bf353063de8bcbcf3dfc-icon-13.svg");
const iconGoogle = img("684a14073e3e3c127cc2a314-logo-google-reviews.svg");
const iconEstrellas = img("684a14073e3e3c127cc2a315-starts.svg");
const flecha = img("684a15893000dfa033be0899-684a120d78059a4010848353-arow.svg");

// Transformaciones de Sanity. Prohibido AVIF, y por eso `fm=webp` y NO
// `auto=format`: `auto=format` no fija formato, negocia por la cabecera
// `Accept`, y Chrome pide `image/avif` primero — asi que el CDN devolvia AVIF.
// `fm=webp` fuerza WebP sea cual sea el navegador. Los SVG no pasan por aqui
// (se sirven crudos): `fm=webp` los rasterizaria.
const src = (a: Asset, w: number) => `${a.url}?w=${w}&q=75&fm=webp`;
const srcset = (a: Asset, ws: number[]) =>
  ws.map((w) => `${src(a, w)} ${w}w`).join(", ");

// Sin lqip a proposito en las cuatro fotos de esta pagina:
//   - las tres de .features son PNG CON CANAL ALFA (RGBA, verificado). Un lqip
//     de fondo se seguiria viendo por las zonas transparentes DESPUES de cargar.
//   - la del hero es eager + fetchpriority=high: no hay hueco que tapar, y el
//     desenfoque saldria detras del H1.

// Los DOCE servicios, como en produccion. Antes se filtraba por `feature`, que
// dejaba 5 en una reticula de 4 columnas: una fila huerfana de un solo elemento
// que se lee como maqueta rota, y 116px menos de seccion que el baseline (332 ->
// 216 medidos a 1440). Centrar esa fila seria inventar una maqueta que no existe
// en produccion; .collection-list ya degrada sola a 2 y a 1 columna.
// El campo `feature` se queda en Sanity: no se toca el CMS.
// El orden es el de produccion: los `feature` primero y, dentro de cada grupo,
// el orden de la coleccion. Por eso `feature` existe — no era un capricho del
// import: es el interruptor "Destacado" de Webflow sobre el que esta lista
// ordenaba. Comprobado contra el baseline: los 5 destacados caen exactamente en
// las posiciones 1-5 y la permutacion completa sale identica.
const servs = await (g.__amsServicios ??= servicios());
if (servs.length !== 12) {
  throw new Error(`Se esperaban 12 servicios, hay ${servs.length}.`);
}
// FASE 2: los 12 se reparten en 3 familias (src/lib/familias.ts). El orden por
// `feature` que reproducia la reticula plana de Webflow ya no aplica: esa
// reticula era la causa de que la portada midiera 24 pantallas en movil.
const familias = agrupar(servs);

// Los 20 testimonios se muestran TAL CUAL: ni se traducen ni se editan, y no
// se reordenan (no hay campo por el que reproducir el orden de produccion).
// Prohibido JSON-LD Review/aggregateRating: no hay rating, ni fecha, ni fuente
// verificable (DECISIONS.md D5).
const opiniones = await testimonios();

// El video de la seccion "about". El id y el titulo salen del <iframe> de
// produccion; la miniatura es la del propio video. Nada de esto es inventado.
const VIDEO = {
  id: "Nx4HDJ-TZn4",
  titulo: "What Is a Financial Advisor?",
  miniatura: "https://i.ytimg.com/vi/Nx4HDJ-TZn4/maxresdefault.jpg",
};

// Entradilla del hero. Vive en una constante porque lo usan DOS sitios — el
// <div> bajo el H1 y la meta description — y no puede divergir entre ellos. Por
// eso se queda en 155 caracteres o menos: es tambien la meta description.
//
// La version de produccion decia "serving clients in Tamarac, FL". Era un
// conflicto de NAP contra la direccion, el H2 de esta misma pagina y NEGOCIO:
// la sede es Coral Springs. Tamarac es zona atendida, no sede.
const ENTRADA =
  "Bilingual tax and accounting in Coral Springs, FL for individuals and " +
  "business owners across Broward County — and for clients filing from abroad.";

// El <title> ya no es "Home": era el unico de las 26 rutas que no decia nada de
// lo que hay en la pagina. 60 caracteres con el sufijo de marca incluido.
const TITULO = `Tax & Accounting, Coral Springs FL | ${NEGOCIO.nombre}`;
---

<BaseLayout title={TITULO} description={ENTRADA}>
  {/* FASE 2: el sitio emitia CERO datos estructurados en las 54 rutas, pese a
      que JsonLd.astro existia entero (252 lineas) y no lo importaba NADIE.
      `tipo="home"` emite el negocio (AccountingService), el WebPage y el
      FAQPage con las 5 preguntas de esta pagina. */}
  <JsonLd tipo="home" nombre={TITULO} descripcion={ENTRADA} faq={c.faq.items} />
  <Nav />

  <main id="main">
    {/* ================================================================ HERO */}
    {/* FASE 2. Una promesa, una prueba, una accion — mas el telefono, que en el
        diseno viejo estaba en display:none a partir de 992px: invisible justo
        en escritorio, y llamar es LA conversion de un despacho contable.

        El H1 NO se reescribe. Es el que sostiene el posicionamiento local y la
        campana de Ads apunta aqui; cambiarlo seria pagar el rediseno con
        trafico. Lo que cambia es todo lo que lo rodea. */}
    <section class="hero">
      <div class="contenido">
        <div class="hero__rejilla">
          <div>
            <ul class="hero__credenciales">
              {c.home.confianza.map((x) => <li>{x.fuerte}</li>)}
            </ul>
            <h1 class="hero__titulo">
              <strong>Enrolled Agents &amp; CPAs in Coral Springs, FL &mdash; Tax, Accounting &amp; IRS Representation</strong>
            </h1>
            <p class="hero__entrada">{ENTRADA}</p>
            <div class="hero__acciones">
              <a href="/contact-us" class="boton boton--principal">{c.home.heroCta}</a>
              <a href={NEGOCIO.telefonoHref} class="boton boton--secundario">
                {interpola(c.home.cierreLlamar, { telefono: NEGOCIO.telefono })}
              </a>
            </div>
          </div>
          {/* La foto ya no va en display:none en movil. Antes se pedia con
              fetchpriority=high y se pintaba a 0x0 (barrido de la fase 0): se
              pagaba la descarga y no se veia. Ahora se ve, y el `sizes` hace
              que en movil baje el candidato pequeno. El LCP sigue siendo el
              H1, que esta encima. */}
          <img
            src={src(hero, 1080)}
            srcset={srcset(hero, [500, 800, 1080, 1600])}
            sizes="(max-width: 62rem) 100vw, 45vw"
            width={hero.w}
            height={hero.h}
            alt={c.home.heroAlt}
            loading="eager"
            decoding="async"
            class="hero__foto"
          />
        </div>
      </div>
    </section>

    {/* ========================================================== CONFIANZA */}
    {/* Las credenciales estaban a 12px en la barra verde de arriba, en blanco
        sobre verde (3,07:1). Son lo mejor que tiene este negocio. */}
    <section class="seccion seccion--corta" aria-label="Credentials">
      <div class="contenido">
        <ul class="confianza revelar">
          {
            c.home.confianza.map((x) => (
              <li class="confianza__item">
                <span class="confianza__fuerte">{x.fuerte}</span>
                <span class="confianza__suave">{x.suave}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* =========================================================== SERVICIOS */}
    {/* Los 12 en 3 familias. Doce tarjetas identicas no son doce opciones: son
        ninguna. Los 12 enlaces se conservan enteros — el enlazado interno no
        pierde ni un destino. */}
    <section class="seccion seccion--alterna" aria-labelledby="servicios-titulo">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="servicios-titulo">{c.home.familiasTitulo}</h2>
          <p>{c.home.familiasIntro}</p>
        </div>
        <div class="familias">
          {
            familias.map((grupo, i) => (
              <article class="familia revelar">
                <span class="familia__numero">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="familia__nombre">{c.home.familias[i].nombre}</h3>
                <p class="familia__resumen">{c.home.familias[i].resumen}</p>
                <ul class="familia__lista">
                  {grupo.map((s) => (
                    <li>
                      <a href={`/services/${s.slug}`} class="familia__enlace">
                        {s.title.trim()}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ============================================================ ABOUT-US */}
    {/* FASE 2: mismas piezas (video + credenciales), clases propias. La caja
        16:9 la da `aspect-ratio` en vez del padding-top en linea que heredaba
        de .w-embed-youtubevideo — un truco de cuando aspect-ratio no existia.
        La fachada click-to-load NO se toca: sigue evitando ~700 KB y las
        cookies de Google en la primera visita. */}
    <section class="seccion" aria-labelledby="about-titulo">
      <div class="contenido">
        <div class="sobre">
          <div class="sobre__video" data-yt-caja>
            <button
              type="button"
              class="yt-facade"
              data-yt-id={VIDEO.id}
              data-yt-titulo={VIDEO.titulo}
              aria-label={interpola(c.home.videoCta, { titulo: VIDEO.titulo })}
            >
              <img
                src={VIDEO.miniatura}
                width="1280"
                height="720"
                alt=""
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <svg class="yt-play" viewBox="0 0 68 48" aria-hidden="true" focusable="false">
                <path
                  d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2 0 34 0 34 0S12.8 0 7.5 1.7a8.5 8.5 0 0 0-6 6A88.6 88.6 0 0 0 0 24a88.6 88.6 0 0 0 1.5 16.3 8.5 8.5 0 0 0 6 6C12.8 48 34 48 34 48s21.2 0 26.5-1.7a8.5 8.5 0 0 0 6-6A88.6 88.6 0 0 0 68 24a88.6 88.6 0 0 0-1.5-16.3z"
                  fill="#212121"
                  fill-opacity="0.8"></path>
                <path d="M27 34V14l18 10-18 10z" fill="#fff"></path>
              </svg>
            </button>
          </div>
          <div class="sobre__texto">
            <h2 id="about-titulo">{c.home.aboutTitle}</h2>
            <p set:html={c.home.aboutHtml} />
            <a href={"/about-us"} class="boton boton--secundario">{c.home.aboutCta}</a>
          </div>
        </div>
      </div>
    </section>


    {/* ============================================================= PROCESO */}
    {/* Seccion nueva. Quita la friccion de «no se que me van a pedir», que en
        servicios fiscales es la objecion numero uno.

        R3: ni una afirmacion nueva. Paso 1 sale del CTA que ya estaba
        publicado («free 30-minute consultation call»), 2 del FAQ 1 y 2 («we'll
        guide you through the checklist», «we handle the paperwork») y 3 del
        FAQ 4. Deliberadamente NO se apoya en «document portals»: el barrido de
        la fase 0 lo marco como promesa sin nada detras. */}
    <section class="seccion" aria-labelledby="proceso-titulo">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="proceso-titulo">{c.home.procesoTitulo}</h2>
        </div>
        <ol class="proceso">
          {
            c.home.procesoPasos.map((paso) => (
              <li class="proceso__paso revelar">
                <h3 class="proceso__titulo">{paso.titulo}</h3>
                <p class="proceso__texto">{paso.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ========================================================= TESTIMONIOS */}
    {/* Carrusel de scroll-snap nativo: cero JavaScript de libreria. Los dos
        botones solo llaman a scrollBy(), y si no hay JS la zona sigue siendo
        desplazable con el dedo, con la rueda y con el teclado.

        D5 SIGUE VIGENTE: se muestran como testimonios y nada mas. Prohibido
        JSON-LD Review o aggregateRating — no hay valoracion, ni fecha, ni
        fuente verificable. */}
    <section class="seccion seccion--alterna" aria-labelledby="reviews-titulo">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="reviews-titulo">{c.reviews.title}</h2>
          <p>{c.reviews.text}</p>
        </div>
        <div
          class="testimonios"
          data-carrusel
          tabindex="0"
          role="group"
          aria-labelledby="reviews-titulo"
        >
          {
            opiniones.map((o) => (
              <figure class="testimonio">
                <blockquote class="testimonio__texto">{o.quote}</blockquote>
                <figcaption>
                  <div class="testimonio__autor">{o.author}</div>
                  <div class="testimonio__fuente">{c.reviews.publicado}</div>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="carrusel__mandos">
          <button type="button" class="carrusel__boton" data-carrusel-prev aria-label={c.reviews.prev}>
            &#8592;
          </button>
          <button type="button" class="carrusel__boton" data-carrusel-next aria-label={c.reviews.next}>
            &#8594;
          </button>
        </div>
      </div>
    </section>

    {/* ============================================================ FEATURES */}
    {/* Mismo contenido que antes, en 3 tarjetas compactas en vez de 3 bandas
        alternas a todo lo ancho. El texto del cliente no se toca. */}
    <section class="seccion" aria-labelledby="features-titulo">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="features-titulo">{c.features.title}</h2>
          <p>{c.features.text}</p>
        </div>
        <div class="familias">
          {
            [feat1, feat3, feat2].map((im, i) => (
              <article class="familia revelar">
                <img
                  src={src(im, 800)}
                  srcset={srcset(im, [500, 800, im.w])}
                  sizes="(max-width: 62rem) 100vw, 30vw"
                  width={im.w}
                  height={im.h}
                  alt={c.home.featuresAlt[i]}
                  loading="lazy"
                  decoding="async"
                  style="width:100%;height:auto;border-radius:var(--radio-control)"
                />
                <h3 class="familia__nombre">{c.features.items[i].title}</h3>
                <p class="familia__resumen" set:html={c.features.items[i].html} />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ================================================================= FAQ */}
    {/* <details>/<summary> nativo. Antes eran <button> + panel con `hidden`
        gestionados por iniciarFaq() en ui.ts; ese codigo se borra en este mismo
        commit porque el acordeon SOLO existia en las dos portadas.

        Lo nativo gana en tres cosas que el JS no daba: se abre sin JavaScript,
        Ctrl+F encuentra texto dentro de un panel cerrado y lo abre, y al
        imprimir sale todo. */}
    <section class="seccion seccion--alterna" aria-labelledby="faq-titulo">
      <div class="contenido">
        <div class="cabecera-seccion">
          <h2 id="faq-titulo">{c.faq.title}</h2>
        </div>
        <div class="faq-lista">
          {
            c.faq.items.map((item) => (
              <details class="faq-item">
                <summary class="faq-item__titulo">{item.q}</summary>
                <p class="faq-item__cuerpo">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* ============================================================== CIERRE */}
    {/* El telefono, visible y pulsable, en todos los anchos. */}
    <section class="seccion seccion--oscura" aria-labelledby="cierre-titulo">
      <div class="contenido">
        <div class="cierre">
          <div class="cierre__texto">
            <h2 id="cierre-titulo">{c.home.cierreTitulo}</h2>
            <p>{c.home.cierreTexto}</p>
          </div>
          <div class="cierre__acciones">
            <a href="/contact-us" class="boton boton--principal">{c.home.heroCta}</a>
            <a href={NEGOCIO.telefonoHref} class="boton boton--secundario">
              {interpola(c.home.cierreLlamar, { telefono: NEGOCIO.telefono })}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Unico CSS propio de esta ruta: la facade del video.
   * No sale del port de Webflow porque en produccion no habia facade, y no
   * puede ir en site.css (es de esta pagina, no del cromo). */
  .yt-facade {
    cursor: pointer;
    background: none;
    border: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    display: block;
    position: absolute;
    inset: 0;
  }

  .yt-facade img {
    object-fit: cover;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Triangulo de reproduccion, centrado sobre la miniatura. */
  .yt-play {
    width: 68px;
    height: 48px;
    transition: opacity 0.2s;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .yt-facade:hover .yt-play,
  .yt-facade:focus-visible .yt-play {
    opacity: 0.75;
  }

  /* Anillo de foco HACIA DENTRO. El global de site.css se pinta entero FUERA de
   * la caja (outline a offset +2px y box-shadow de 4px de extension), y este
   * boton mide exactamente lo mismo que su contenedor .w-embed-youtubevideo,
   * que lleva overflow:hidden: el anillo se recortaba al 100% y el unico
   * indicador que quedaba era la bajada de opacidad del triangulo, IDENTICA a
   * la de :hover. Un usuario de teclado no distinguia foco de raton
   * (SC 2.4.7 y 2.4.11). Se conservan los dos tonos del anillo global.
   *
   * La banda navy va en un ::after y no en un `box-shadow: inset` del propio
   * boton porque la miniatura cubre el 100% de la caja y taparia la sombra: un
   * pseudoelemento posicionado si se pinta por encima del contenido en flujo.
   * La banda blanca es el `outline` del boton, con offset NEGATIVO. */
  .yt-facade:focus-visible {
    outline: 2px solid var(--blanco);
    outline-offset: -4px;
    box-shadow: none;
  }

  .yt-facade:focus-visible::after {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    /* Solo 2px: la banda navy ocupa 0-2px y la blanca del outline 2-4px, sin
     * solaparse. Con 4px aqui el ::after tapaba el outline (Chrome pinta el
     * pseudoelemento posicionado por encima) y el anillo salia de un solo tono. */
    box-shadow: inset 0 0 0 2px var(--navy);
  }
</style>

<script>
  // Facade del video: hasta que no se pulsa, el navegador no habla con YouTube.
  // Se usa youtube-nocookie.com y no youtube.com (que es lo que servia
  // produccion) porque no hay politica de privacidad publicada todavia
  // (DECISIONS.md D4): menos cookies de terceros mientras eso siga abierto.
  const boton = document.querySelector<HTMLButtonElement>("button.yt-facade");
  const caja = boton?.closest<HTMLElement>("[data-yt-caja]");

  if (boton && caja) {
    boton.addEventListener(
      "click",
      () => {
        const marco = document.createElement("iframe");
        // autoplay=1 es legitimo aqui: lo dispara un clic de la persona.
        marco.src =
          `https://www.youtube-nocookie.com/embed/${boton.dataset.ytId}` +
          "?rel=0&controls=1&autoplay=1&mute=0&start=0";
        marco.title = boton.dataset.ytTitulo ?? "";
        // `fullscreen` va SOLO dentro de allow. Con el atributo legacy
        // allowFullscreen ademas, Chrome avisa por consola en cada clic
        // ("Allow attribute will take precedence over 'allowfullscreen'") y lo
        // ignora igual, asi que sobra.
        marco.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
        marco.style.cssText =
          "position:absolute;left:0;top:0;width:100%;height:100%;border:0";
        caja.replaceChild(marco, boton);
        // El boton que tenia el foco acaba de desaparecer: sin esto el foco se
        // iria al principio del documento.
        marco.focus();
      },
      { once: true },
    );
  }
</script>
