---
// Portada.
//
// Estructura y clases copiadas VERBATIM de baseline/html/index.html, en el
// mismo orden: header · bar-services · about-us · reviews · features ·
// call-action · faq. El cromo (menu y pie) lo ponen Nav y Footer.
//
// Los datos salen de Sanity; los textos de seccion son los de produccion, sin
// reescribir (R3). Cero CSS nuevo salvo la facade del video, que no existe en
// el port de Webflow porque en produccion no habia facade.
//
// Diferencias deliberadas respecto al HTML de produccion, todas justificadas
// abajo en su sitio:
//   - Fuera los `data-w-id` y los `style="opacity:0"` de las interacciones de
//     Webflow. Sin webflow.js esos inline styles dejan el H1, el bloque de
//     "about" y el titulo del FAQ INVISIBLES para siempre.
//   - Fuera el `style="height:0px"` del panel de FAQ, por lo mismo: sin JS el
//     acordeon se queda cerrado y el contenido inalcanzable.
//   - El acordeon pasa de <a href="#"> a <button type="button">.
//   - Las flechas del carrusel pasan de <div> a <button type="button">.
//   - El <iframe> de YouTube pasa a facade click-to-load.
//   - Fuera el <div class="w-embed"><style>…</style></div> de .reviews: esas
//     cuatro reglas (.corner-top-1/2, .corner-bottom-1/2) ya estan en el CSS
//     portado (accounting-max.webflow.css:1386-1417).
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import CtaConsulta from "../components/CtaConsulta.astro";
import PuntosConfianza from "../components/PuntosConfianza.astro";
import CarruselLogos from "../components/CarruselLogos.astro";
import ServiciosPorCategoria from "../components/ServiciosPorCategoria.astro";
import { testimonios, sanity, NEGOCIO } from "../lib/sanity";

// Assets sueltos en Sanity (sin documento que los referencie). Se piden por
// nombre original en una sola consulta, igual que hacen Nav y Footer.
const MEDIOS = [
  "6658e5a9a386bf0eb1b0c6a0-main-picture.jpg",
  "66591cff761a876e791ad585-1.png",
  "66591defc9bd4c2b2a6fd8c8-2.png",
  "66591fc962e8774f9117068b-3.png",
  "684a14073e3e3c127cc2a314-logo-google-reviews.svg",
  "684a14073e3e3c127cc2a315-starts.svg",
  "684a15893000dfa033be0899-684a120d78059a4010848353-arow.svg",
];

type Asset = { originalFilename: string; url: string; w: number; h: number };

const assets: Asset[] = await sanity.fetch(
  `*[_type == "sanity.imageAsset" && originalFilename in $f]{
     originalFilename, url,
     "w": metadata.dimensions.width,
     "h": metadata.dimensions.height
   }`,
  { f: MEDIOS },
);

/** Falla en voz alta: una imagen rota en la portada es la primera impresion. */
const img = (nombre: string): Asset => {
  const a = assets.find((x) => x.originalFilename === nombre);
  if (!a) throw new Error(`Falta en Sanity el asset "${nombre}" (portada).`);
  return a;
};

const hero = img("6658e5a9a386bf0eb1b0c6a0-main-picture.jpg");
const feat1 = img("66591cff761a876e791ad585-1.png");
const feat2 = img("66591defc9bd4c2b2a6fd8c8-2.png");
const feat3 = img("66591fc962e8774f9117068b-3.png");
const iconGoogle = img("684a14073e3e3c127cc2a314-logo-google-reviews.svg");
const iconEstrellas = img("684a14073e3e3c127cc2a315-starts.svg");
const flecha = img("684a15893000dfa033be0899-684a120d78059a4010848353-arow.svg");

// Transformaciones de Sanity. Prohibido AVIF, y por eso `fm=webp` y NO
// `auto=format`: `auto=format` no fija formato, negocia por la cabecera
// `Accept`, y Chrome pide `image/avif` primero — asi que el CDN devolvia AVIF.
// `fm=webp` fuerza WebP sea cual sea el navegador. Los SVG no pasan por aqui
// (se sirven crudos): `fm=webp` los rasterizaria.
const src = (a: Asset, w: number) => `${a.url}?w=${w}&q=75&fm=webp`;
const srcset = (a: Asset, ws: number[]) =>
  ws.map((w) => `${src(a, w)} ${w}w`).join(", ");

// Sin lqip a proposito en las cuatro fotos de esta pagina:
//   - las tres de .features son PNG CON CANAL ALFA (RGBA, verificado). Un lqip
//     de fondo se seguiria viendo por las zonas transparentes DESPUES de cargar.
//   - la del hero es eager + fetchpriority=high: no hay hueco que tapar, y el
//     desenfoque saldria detras del H1.

// Los DOCE servicios ya NO se piden aqui: se los trae ServiciosPorCategoria.astro
// por el mismo memo de globalThis, igual que Nav.astro y Footer.astro. Alli
// tambien vive el conteo de 12 y el orden `feature desc, order asc`.

// Los 20 testimonios se muestran TAL CUAL: ni se traducen ni se editan, y no
// se reordenan (no hay campo por el que reproducir el orden de produccion).
// Prohibido JSON-LD Review/aggregateRating: no hay rating, ni fecha, ni fuente
// verificable (DECISIONS.md D5).
const opiniones = await testimonios();

// El video de la seccion "about". El id y el titulo salen del <iframe> de
// produccion; la miniatura es la del propio video. Nada de esto es inventado.
const VIDEO = {
  id: "Nx4HDJ-TZn4",
  titulo: "What Is a Financial Advisor?",
  miniatura: "https://i.ytimg.com/vi/Nx4HDJ-TZn4/maxresdefault.jpg",
};

// Entradilla del hero. Vive en una constante porque lo usan DOS sitios — el
// <div> bajo el H1 y la meta description — y no puede divergir entre ellos. Por
// eso se queda en 155 caracteres o menos: es tambien la meta description.
//
// La version de produccion decia "serving clients in Tamarac, FL". Era un
// conflicto de NAP contra la direccion, el H2 de esta misma pagina y NEGOCIO:
// la sede es Coral Springs. Tamarac es zona atendida, no sede.
const ENTRADA =
  "Bilingual tax and accounting in Coral Springs, FL for individuals and " +
  "business owners across Broward County — and for clients filing from abroad.";

// El <title> ya no es "Home": era el unico de las 26 rutas que no decia nada de
// lo que hay en la pagina. 60 caracteres con el sufijo de marca incluido.
const TITULO = `Tax & Accounting, Coral Springs FL | ${NEGOCIO.nombre}`;
---

<BaseLayout title={TITULO} description={ENTRADA}>
  <JsonLd slot="head" tipo="home" nombre={TITULO} descripcion={ENTRADA} />
  <Nav />

  <main id="main">
    {/* ================================================================ HERO */}
    <section class="header">
      <div class="wrapper-header">
        <div class="w-layout-blockcontainer container w-container">
          {/* Sin style="opacity:0": era una interaccion de webflow.js y sin el
              dejaba el H1 invisible de forma permanente. */}
          <div class="block-header">
            <h1 class="h1"><strong>Enrolled Agents &amp; CPAs in Coral Springs, FL &mdash; Tax, Accounting &amp; IRS Representation</strong></h1>
            <div>{ENTRADA}</div>
            <a href="/contact-us" class="button w-button">Book a consultation</a>
            <PuntosConfianza />
          </div>
        </div>
      </div>
      {/* Imagen principal. Es el LCP en ESCRITORIO (.background-header va a
          inset:0 con object-fit:cover detras del titular).
          Por debajo de 992px el vendor la pone en display:none
          (accounting-max:2194) — es del propio Webflow, no un fallo.

          LA ENVOLTURA DE ABAJO NO ES ADORNO. `display:none` NO cancela la
          descarga de una imagen en ningun motor: medido en el navegador, la
          portada movil resolvia `sizes=100vw` a la variante de 800w y se la
          traia con fetchpriority=high para no pintar absolutamente nada. La
          fuente alternativa casa por debajo de 992px con un pixel transparente
          en data: (cero red), asi que el navegador ya no llega a pedir la foto.
          Por encima de 992 no casa ninguna y manda el srcset de la imagen: el
          LCP de escritorio no cambia ni un byte.

          OJO CON EL data: — el valor va en base64 y SIN UN SOLO ESPACIO a
          proposito. En un `srcset` el espacio separa la URL de su descriptor,
          asi que un SVG en linea (que lleva espacios entre atributos) se parte:
          el navegador lee media URL, descarta el candidato por invalido, se
          queda sin fuentes y cae en la imagen de siempre. El fallo es
          silencioso —ni consola ni error— y solo se ve mirando las peticiones
          de red. Ya paso una vez aqui. */}
      <picture>
        <source
          media="(max-width: 991px)"
          srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        />
        <img
          src={src(hero, 2000)}
          srcset={srcset(hero, [500, 800, 1080, 1600, 2000])}
          sizes="100vw"
          width={hero.w}
          height={hero.h}
          alt="Blank IRS Form 1040 and Form 1120 tax returns on a white desk with a pen, reading glasses and a calculator."
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="background-header"
        />
      </picture>
    </section>

    {/* =========================================================== LOGOS */}
    <CarruselLogos />

    {/* ====================================================== BAR-SERVICES */}
    <ServiciosPorCategoria />

    {/* ============================================================ ABOUT-US */}
    <section class="about-us" aria-labelledby="about-title">
      <div class="w-layout-blockcontainer container w-container">
        <div class="wrapper-about">
          <div class="block-video">
            {/* Facade click-to-load. En produccion aqui habia un <iframe> de
                youtube.com que se cargaba siempre: ~700 KB y cookies de Google
                en la primera visita, sin que nadie le diera al play. El iframe
                se inyecta al pulsar el boton (ver el <script> del final).
                El padding-top en linea es el del HTML original: crea la caja de
                proporcion 16:9 sobre la que .w-embed-youtubevideo se apoya. */}
            <div
              class="w-embed-youtubevideo youtube"
              style="padding-top:56.17021276595745%"
              data-yt-caja
            >
              <button
                type="button"
                class="yt-facade"
                data-yt-id={VIDEO.id}
                data-yt-titulo={VIDEO.titulo}
                aria-label={`Play the video: ${VIDEO.titulo}`}
              >
                {/* alt="": el nombre accesible ya lo da el aria-label del boton;
                    describir ademas la miniatura lo diria todo dos veces. */}
                <img
                  src={VIDEO.miniatura}
                  width="1280"
                  height="720"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
                <svg class="yt-play" viewBox="0 0 68 48" aria-hidden="true" focusable="false">
                  <path
                    d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2 0 34 0 34 0S12.8 0 7.5 1.7a8.5 8.5 0 0 0-6 6A88.6 88.6 0 0 0 0 24a88.6 88.6 0 0 0 1.5 16.3 8.5 8.5 0 0 0 6 6C12.8 48 34 48 34 48s21.2 0 26.5-1.7a8.5 8.5 0 0 0 6-6A88.6 88.6 0 0 0 68 24a88.6 88.6 0 0 0-1.5-16.3z"
                    fill="#212121"
                    fill-opacity="0.8"></path>
                  <path d="M27 34V14l18 10-18 10z" fill="#fff"></path>
                </svg>
              </button>
            </div>
            {/* Adornos: cuadros de color detras del video. Vacios en origen. */}
            <div class="block-deco-1"><div class="block-deco-2"></div></div>
            <div class="block-deco-1-copy"><div class="block-deco-2"></div></div>
          </div>

          {/* El id lo usa el CSS portado (#w-node-_42cc5f49-… en el @media de
              991px, accounting-max.webflow.css:3021). No se puede quitar. */}
          <div id="w-node-_42cc5f49-40c0-a4b2-857a-f634d5f3ff7b-9d7e9d67" class="block-about-us">
            <div class="block-info-content">
              <h2 class="h2" id="about-title">
                <strong>IRS Enrolled Agents &amp; Certified Public Accountants In Coral Springs, FL </strong>
              </h2>
              <div>
                At Accounting Max Services, our team includes Enrolled Agents licensed to practice before the IRS (EAs)
                and Certified Public Accountants (CPAs), offering the highest level of tax
                expertise and compliance support.<br />We provide a full range of <strong
                  >global tax and accounting solutions</strong
                >—serving both individuals and businesses in Coral Springs, FL, and
                internationally. Whether you’re managing cross-border finances, running a U.S.
                business, or dealing with complex international tax matters, our specialists
                deliver accurate, personalized guidance every step of the way.
              </div>
              <a href="/about-us" class="button blue w-button">More About Us</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================= REVIEWS */}
    <section class="reviews">
      <div class="w-layout-blockcontainer container w-container">
        <section class="wrapper-reviews" aria-labelledby="reviews-title">
          <div class="w-layout-blockcontainer container w-container">
            <div class="wrapper-header-slider">
              <div class="box-title-review">
                <h2 class="h2" id="reviews-title">What Our Customers Are Saying About Us</h2>
                <div>
                  Trusted by small business owners nationwide, Accounting Max Services is known
                  for delivering results. Discover how we’ve helped businesses succeed—read our
                  customer success stories.
                </div>
              </div>
              {/* Las flechas eran <div> sin rol, sin foco y sin teclado. Ahora
                  son <button> reales; ui.ts les engancha el desplazamiento y
                  las inhabilita en los extremos. */}
              <div class="block-button-slider">
                <button
                  type="button"
                  class="button-slider-cms prev-splide"
                  aria-label="Previous testimonials"
                  aria-controls="reviews-track"
                >
                  {/* Flechas decorativas: el nombre lo da el aria-label. */}
                  <img
                    src={flecha.url}
                    width={flecha.w}
                    height={flecha.h}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="flecha back"
                  />
                </button>
                <button
                  type="button"
                  class="button-slider-cms next-splide"
                  aria-label="Next testimonials"
                  aria-controls="reviews-track"
                >
                  <img
                    src={flecha.url}
                    width={flecha.w}
                    height={flecha.h}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="flecha"
                  />
                </button>
              </div>
            </div>

            <div class="block-services-animation">
              <div class="splide">
                {/* ui.ts hace la pista alcanzable con teclado (2.1.1) y le pone
                    role=group; el nombre lo damos aqui con el h2 de arriba. */}
                <div
                  id="reviews-track"
                  class="splide-track w-dyn-list"
                  aria-labelledby="reviews-title"
                >
                  <div role="list" class="splide-list w-dyn-items">
                    {
                      opiniones.map((o) => (
                        <div role="listitem" class="splide-slide w-dyn-item">
                          <div class="block-review">
                            <div class="block-header-review">
                              <div>
                                <div>
                                  <img
                                    src={iconGoogle.url}
                                    width={iconGoogle.w}
                                    height={iconGoogle.h}
                                    alt="Google reviews icon"
                                    loading="lazy"
                                    decoding="async"
                                    class="icon-google"
                                  />
                                  {/* Las estrellas son decorativas: el texto de
                                      al lado ya dice "5.0 Ranking on Google
                                      reviews". */}
                                  <img
                                    src={iconEstrellas.url}
                                    width={iconEstrellas.w}
                                    height={iconEstrellas.h}
                                    alt=""
                                    loading="lazy"
                                    decoding="async"
                                    class="icon-start"
                                  />
                                </div>
                                <div class="mini-text-reviews">5.0 Ranking on Google reviews</div>
                              </div>
                            </div>
                            <p class="paragraph">{o.quote}</p>
                            <div>
                              <div class="name-customer">{o.author}</div>
                              <div class="block-city">
                                <div class="text-mini-reviews">Published on Google</div>
                              </div>
                            </div>
                          </div>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      {/* Esquinas decorativas del bloque azul. Vacias en origen. */}
      <div class="corner-top-1"></div>
      <div class="corner-bottom-1"></div>
      <div class="corner-top-2"></div>
      <div class="corner-bottom-2"></div>
    </section>

    {/* ============================================================ FEATURES */}
    <section class="features" aria-labelledby="features-title">
      <div class="w-layout-blockcontainer container w-container">
        <div class="title-center">
          {/* El <br> final es del HTML de produccion: se conserva por paridad. */}
          <h2 class="h2" id="features-title">What to expect from accounting Max Services?<br /></h2>
          <div>
            At Accounting Max Services, we prioritize delivering exceptional service to our
            clients by offering personalized financial and tax solutions. When you work with us,
            you can expect expert guidance, transparent communication, and a commitment to your
            financial success.
          </div>
        </div>
        <div class="div-block-5">
          {/* Los <div> sin clase que envuelven imagen y texto son las CELDAS del
              grid de .div-block-4 (1fr 1fr). Quitarlos rompe la maqueta. */}
          <div class="div-block-4">
            <div>
              <img
                src={src(feat1, 1080)}
                srcset={srcset(feat1, [500, 800, 1080, feat1.w])}
                sizes="(max-width: 767px) 100vw, (max-width: 991px) 95vw, 940px"
                width={feat1.w}
                height={feat1.h}
                alt="Messaging app with a customer conversation, insets of two advisors on headset calls and a Book a call button."
                loading="lazy"
                decoding="async"
                class="image-2"
              />
            </div>
            <div>
              <h3 class="h3">One-on-one expert support</h3>
              <div>
                We believe in building strong, lasting relationships with our clients. With <strong
                  >one-on-one expert support</strong
                >, you'll have direct access to knowledgeable professionals who understand your
                unique financial needs. Whether you're a business owner or an individual, we'll
                work closely with you to ensure all your questions are answered and your goals are
                met with precision. Our personalized approach ensures you never feel lost in the
                process—you're always in capable hands.
              </div>
            </div>
          </div>

          <div class="div-block-4 rotate">
            <div>
              <h3 class="h3">Powerful financial reporting</h3>
              <div>
                Our <strong>financial reporting</strong> services provide you with detailed, accurate
                insights into the health of your business or personal finances. We prepare <strong
                  >customized financial statements</strong
                > such as income statements, balance sheets, and cash flow reports to help you make
                informed decisions. With our <strong>powerful financial reporting</strong>, you’ll
                gain a clear understanding of your financial position, giving you the tools to plan
                effectively, secure funding, and grow your business with confidence.
              </div>
            </div>
            <div>
              <img
                src={src(feat3, 1080)}
                srcset={srcset(feat3, [500, 800, 1080, feat3.w])}
                sizes="(max-width: 767px) 100vw, (max-width: 991px) 95vw, 940px"
                width={feat3.w}
                height={feat3.h}
                alt="Accounting dashboard showing sales revenue and a Top Expenses breakdown by category, reviewed by an advisor on a tablet."
                loading="lazy"
                decoding="async"
                class="image-2"
              />
            </div>
          </div>

          <div class="div-block-4">
            <div>
              <img
                src={src(feat2, 1080)}
                srcset={srcset(feat2, [500, 800, 1080, feat2.w])}
                sizes="(max-width: 767px) 100vw, (max-width: 991px) 95vw, 940px"
                width={feat2.w}
                height={feat2.h}
                alt="Accounting dashboard with total revenue, total expenses and net profit next to a monthly revenue and profit chart."
                loading="lazy"
                decoding="async"
                class="image-2"
              />
            </div>
            <div>
              <h3 class="h3">Tax season, minus the stress</h3>
              <div>
                Tax season can be overwhelming, but with Accounting Max Services, it doesn’t have
                to be. We handle every aspect of <strong>tax preparation</strong>—from gathering
                your documents to filing your returns—so you can relax. Our goal is to make the
                process as seamless and stress-free as possible, ensuring that your taxes are filed
                accurately, on time, and with maximum refunds or minimized liabilities. With our
                team by your side, you’ll never have to worry about tax season again.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ========================================================= CALL-ACTION */}
    <CtaConsulta tituloId="cta-title" />

    {/* ================================================================= FAQ */}
    <section class="faq" aria-labelledby="faq-title">
      <div class="w-layout-blockcontainer container w-container">
        <div class="container-faq">
          <div class="block-title-faq">
            <h2 class="h2" id="faq-title">Frequently Asked Questions</h2>
            {/* R3: en produccion aqui hay texto de relleno de Webflow ("This is
                some text inside of a div block."). Ni se copia ni se inventa un
                sustituto: el hueco queda a la vista. */}
            {/* Sin entradilla bajo el titulo del FAQ. En produccion ese <div>
                contiene literalmente "This is some text inside of a div block.",
                el placeholder por defecto de Webflow — igual que el equipo demo,
                es relleno de plantilla que lleva vivo en el sitio del cliente.
                Migrarlo seria propagar un defecto; inventar una entradilla en el
                sitio de un despacho fiscal esta prohibido (R3). Se omite y se
                reporta como D12. */}
          </div>

          {/* Fila de dos columnas: ilustracion a la izquierda, acordeon a la
              derecha. Por debajo de 992 cae a una sola columna con las
              preguntas ARRIBA (site.css le da order:2 a la imagen). */}
          <div class="faq-row">
            {/* En public/ y no en Sanity: es la unica imagen de contenido que
                no viene del CMS. Evita necesitar token de escritura y deja
                controlar el nombre de fichero, que aqui es SEO. Sin AVIF
                (mismo motivo que el `fm=webp` de arriba) y sin lqip: el PNG
                tiene alfa y un fondo de baja resolucion se seguiria viendo por
                las zonas transparentes despues de cargar.
                `sizes` sale de medir el contenedor: .container gana a
                .w-container en los cuatro breakpoints (1250/668/538/375) y
                .faq aporta 2em de padding por lado = 64px. En escritorio la
                columna es (1250-64)/2 = 593px, no 45vw. Y va en px, no en em:
                en `sizes` las unidades de tipo se resuelven contra la RAIZ,
                mientras que el padding lo hace contra los 16px fijos de body. */}
            <img
              src="/images/accounting-max-services-help-center-faq-support-1200.webp"
              srcset="/images/accounting-max-services-help-center-faq-support-800.webp 800w, /images/accounting-max-services-help-center-faq-support-1200.webp 1200w, /images/accounting-max-services-help-center-faq-support-1600.webp 1600w"
              sizes="(min-width: 992px) calc((min(1250px, 100vw - 64px) - 64px) / 2), (min-width: 768px) min(668px, 100vw - 64px), min(538px, 100vw - 64px)"
              width="1200"
              height="896"
              alt="Help center screen with a search box and a list of expandable questions, next to a chat reply, a confirmation card and an Ask us anything button, with two support advisors."
              loading="lazy"
              decoding="async"
              class="image-faq"
            />

            {/* Acordeon. El marcado es el que documenta scripts/ui.ts, que le pone
                aria-expanded/aria-controls y esconde los paneles al arrancar.
                Sin JS los cinco quedan abiertos y legibles: .faq-answer es
                height:auto en el CSS portado. Por eso no se emite el
                style="height:0px" del original. */}
            <div class="block-faq">
              {
