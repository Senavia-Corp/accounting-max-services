---
// Sobre nosotros — /about-us
//
// Estructura y clases copiadas de baseline/html/about-us.html. El texto es
// copia real del cliente y va literal, incluidos sus dos guiones largos, sus
// comillas tipograficas y sus erratas (ver NOTA de los <em> mas abajo).
//
// R2 — LA SECCION DE EQUIPO NO SE CONSTRUYE.
// El baseline trae <section class="team"> con seis personas de plantilla de
// Webflow (Robert Garcia, Laura Miller, Chris Jones, Sarah Wilson, David Brown,
// Emily Davis), todas con correo @example.com y foto placeholder, incluido un
// "Software Engineer" en un despacho contable. No se migran, no se sustituyen
// por nombres inventados y no se deja hueco marcado: la seccion simplemente no
// existe aqui. Ver D1 en DECISIONS.md. Si el cliente entrega seis fichas
// reales, se anaden entonces — no antes.
//
// Diferencias deliberadas respecto al HTML de produccion:
//   - Los <div data-w-id="…" style="opacity:0"> eran objetivos de las
//     interacciones de Webflow: webflow.js les subia la opacidad a 1 al entrar
//     en pantalla. Sin webflow.js ese estilo en linea dejaria la pagina EN
//     BLANCO. Se conservan los <div> (son las celdas del grid) y se cae el
//     style/data-w-id.
//   - Los cuatro titulares de bar-features eran <h3> justo despues del <h1>:
//     un salto de nivel. Pasan a <h2> conservando class="h3 title-special", que
//     es lo que los estiliza. Comprobado en el CSS portado: .h3 fija las mismas
//     siete propiedades que la regla de elemento h2, asi que el render es
//     identico al pixel.
//   - <section class="container"> y <section class="footer-subscribe"> pasan a
//     <div>. Eran elementos de seccion sin nombre accesible; ninguna de las dos
//     clases hace mas que maquetar.
//   - Las tres fotos llevan alt real. En produccion las 111 imagenes del sitio
//     van con alt="" salvo dos.
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { sanity } from "../lib/sanity";

// Assets sueltos en Sanity (sin documento que los referencie), igual que en
// Nav/Footer: las URL de cdn.prod.website-files.com estan prohibidas.
const NOMBRES = [
  "6849e6147012d174d25cfab6-1700-n-university-dr-coral-springs-fl-aerial-2-largehighdefinition-copia.webp",
  "68701233f93e3383147d1a60-validation.png",
  "6870123fd6bfee6489fdaeac-bilingual.png",
  "6870124c5e68d92f652dbf9d-financial-statement.png",
  "68701296d6420dd033c71c8d-satisfaction.png",
  "6870159e4206bf0d27b834a9-mission.webp",
  "6870159ea2fefa14c4296c25-vision.webp",
  "6785bf353063de8bcbcf3dfc-icon-13.svg",
];

type Asset = {
  originalFilename: string;
  url: string;
  w: number;
  h: number;
  lqip?: string;
};

const assets: Asset[] = await sanity.fetch(
  `*[_type == "sanity.imageAsset" && originalFilename in $f]{
     originalFilename, url,
     "w": metadata.dimensions.width,
     "h": metadata.dimensions.height,
     "lqip": metadata.lqip
   }`,
  { f: NOMBRES },
);

/** Falla en voz alta: mejor romper el build que publicar un hueco. */
const img = (nombre: string): Asset => {
  const a = assets.find((x) => x.originalFilename === nombre);
  if (!a) throw new Error(`Falta en Sanity el asset "${nombre}" de /about-us.`);
  return a;
};

const hero = img(NOMBRES[0]);
const mision = img(NOMBRES[5]);
const vision = img(NOMBRES[6]);
const iconoCta = img(NOMBRES[7]);

// Transformaciones de Sanity. Prohibido AVIF: auto=format sirve WebP.
const src = (a: Asset, w: number) => `${a.url}?w=${w}&q=75&auto=format`;
const ANCHOS = [500, 800, 1080, 1250];
const srcset = (a: Asset) => ANCHOS.map((w) => `${src(a, w)} ${w}w`).join(", ");

// El lqip (~600 bytes) tapa el hueco mientras carga la foto. Va como fondo del
// propio <img>: cuando la imagen real pinta, lo cubre.
const lqip = (a: Asset) =>
  a.lqip ? `background-image:url(${a.lqip});background-size:cover;background-position:50% 50%` : undefined;

// Anchos reales medidos sobre el CSS portado, no copiados del `sizes` de
// Webflow (que anunciaba 1250px para una columna que nunca pasa de 609):
//   .header-page-about-us: padding 2em + .container 1250 + grid 1fr 1fr, gap 2em
//   -> (1250 - 32) / 2 = 609px.  A <=991px el grid cae a una sola columna.
const SIZES_HERO =
  "(max-width: 991px) calc(100vw - 64px), (max-width: 1313px) calc((100vw - 96px) / 2), 609px";
// .wrapper-mission / .wrapper-vision estan limitados a 1000px -> (1000-32)/2.
const SIZES_MV =
  "(max-width: 991px) calc(100vw - 64px), (max-width: 1063px) calc((100vw - 96px) / 2), 484px";

// bar-features. Texto literal del baseline.
//
// NOTA (R3): en los items 2, 3 y 4 NO hay espacio entre el </em> y la frase que
// sigue — en produccion se lee hoy "your choice.We proudly serve". Es una
// errata del cliente y se migra tal cual; corregirla seria editar su copia.
// Queda reportada.
const CARACTERISTICAS = [
  {
    icono: NOMBRES[1],
    titulo: "Certified Expertise",
    destacado: "IRS Enrolled Agents & CPAs at your service. ",
    texto:
      "Our team holds the highest credentials in the industry, ensuring you receive professional, compliant, and up-to-date tax and accounting guidance.",
  },
  {
    icono: NOMBRES[2],
    titulo: "Bilingual Support",
    destacado: "English or Spanish—your language, your choice.",
    texto:
      "We proudly serve a diverse client base with personalized financial services available in both English and Spanish for clear, confident communication.",
  },
  {
    icono: NOMBRES[3],
    titulo: "Full-financial services",
    destacado: "One trusted partner for all your financial needs.",
    texto:
      "From tax prep and bookkeeping to audits and incorporations, we offer end-to-end solutions for individuals and businesses, both local and international.",
  },
  {
    icono: NOMBRES[4],
    titulo: "Personalized Attention",
    destacado: "We treat your finances like our own.",
    texto:
      "Every client receives tailored support, fast response times, and a clear explanation of every step—so you’re never left in the dark.",
  },
];

// La ruta viva sirve <title>About Us</title> a secas y NINGUNA meta description
// (verificado en baseline/html/about-us.html). El nombre del negocio sale de
// NEGOCIO via el resto del sitio; la description es la primera frase literal
// del propio cliente, recortada. No se redacta nada nuevo (R3).
const DESCRIPCION =
  "At Accounting Max Services, we provide expert tax and accounting solutions for individuals and businesses across the U.S. and abroad.";
---

<BaseLayout title="About Us | Accounting Max Services" description={DESCRIPCION}>
  <Nav />

  <main>
    <section class="header-page-about-us">
      <div class="container">
        <div class="wrapper-about-us">
          <div>
            {/* Hero: unica imagen de la pagina que NO va lazy. */}
            <img
              src={src(hero, 1250)}
              srcset={srcset(hero)}
              sizes={SIZES_HERO}
              width={hero.w}
              height={hero.h}
              alt="Aerial view of the three-story office building with a tile roof and teal awnings at 1700 N University Drive, Coral Springs, Florida"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              style={lqip(hero)}
              class="pic-about-us"
            />
          </div>
          <div>
            <h1 class="h1">Trusted Tax & Accounting Experts in Coral Springs</h1>
            <div>
              At Accounting Max Services, we provide expert tax and accounting solutions for
              individuals and businesses across the U.S. and abroad. As IRS Certified Enrolled
              Agents and CPAs, our mission is to deliver accurate, timely, and personalized
              financial services to help you stay compliant and grow with confidence. Based in <strong
                >Coral Springs, Florida</strong
              >, we’ve proudly supported our clients since 2009 with everything from tax
              preparation and business incorporation to bookkeeping, IRS representation, and audit
              assistance. All our services are available in <strong>English and Spanish</strong>,
              making financial clarity accessible to everyone. Whether you’re a business owner,
              freelancer, or international client, we’re here to help you navigate complex tax laws
              and achieve financial peace of mind.
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bar-features">
      <div class="w-layout-blockcontainer container w-container">
        <div class="wrapper-bar-features">
          <div class="wrapper-bar-features-intro">
            {
              CARACTERISTICAS.map((c) => {
                const icono = img(c.icono);
                return (
                  <div class="block-item-features">
                    {/* Decorativo: el titular de debajo dice lo mismo. Los
                        cuatro son PNG cuadrados de 512, servidos a 200 para
                        cubrir 2x el alto real de 100px que fija .icon-feature. */}
                    <img
                      src={src(icono, 200)}
                      width="200"
                      height="200"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="icon-feature"
                    />
                    <h2 class="h3 title-special">{c.titulo}</h2>
                    <div><em>{c.destacado}</em>{c.texto}</div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>

    <section class="mission-vision">
      <div class="w-layout-blockcontainer container w-container">
        <div class="wrapper-mission">
          <div class="block-left-info">
            <img
              src={src(mision, 1250)}
              srcset={srcset(mision)}
              sizes={SIZES_MV}
              width={mision.w}
              height={mision.h}
              alt="A hand places a dart in the bullseye of a target resting on printed charts, beside a laptop"
              loading="lazy"
              decoding="async"
              style={lqip(mision)}
              class="pic-about-us"
            />
          </div>
          <div class="block-right-info">
            <h2 class="h2">Our Mission</h2>
            <div>
              At Accounting Max Services, our mission is to empower individuals and businesses with
              reliable, accurate, and accessible tax and accounting solutions. We are committed to
              delivering expert guidance with integrity, professionalism, and personalized
              attention—ensuring our clients stay compliant, make informed decisions, and achieve
              financial peace of mind. As IRS Certified Enrolled Agents and CPAs, we proudly serve a
              diverse community with bilingual support, building long-term relationships based on
              trust, transparency, and results.
            </div>
            <a href="/contact-us" class="button w-button">Book A Consultation</a>
          </div>
        </div>

        {/* A <=991px .wrapper-vision usa flex-flow:wrap-reverse, asi que la foto
            sube por encima del texto sin tocar el orden del DOM. */}
        <div class="wrapper-vision">
          <div class="block-left-info">
            <h2 class="h2">Our Vision </h2>
            <div>
              To be a leading bilingual tax and accounting firm recognized for excellence, trust,
              and innovation—empowering individuals and businesses across the U.S. and beyond to
              thrive financially through expert, ethical, and personalized service.
            </div>
            <a href="/contact-us" class="button w-button">Book A Consultation</a>
          </div>
          <div class="block-right-info">
            <img
              src={src(vision, 1250)}
              srcset={srcset(vision)}
              sizes={SIZES_MV}
              width={vision.w}
              height={vision.h}
              alt="A person stands at a floor-to-ceiling office window looking out over a city skyline, with eyeglasses and documents on the desk in the foreground"
              loading="lazy"
              decoding="async"
              style={lqip(vision)}
              class="pic-about-us"
            />
          </div>
        </div>
      </div>
    </section>

    {/* OJO: esta .footer-subscribe es de la PAGINA, no la del cromo. La del pie
        (la newsletter) la pone Footer.astro via FooterSubscribe.astro. */}
    <section class="call-action">
      <div class="w-layout-blockcontainer container w-container">
        <div class="footer-subscribe">
          <div class="wrapper-call-action">
            <div class="block-content-call-to-action">
              {/* Decorativo: el titular de al lado ya dice que es la llamada. */}
              <img
                src={iconoCta.url}
                width={iconoCta.w}
                height={iconoCta.h}
                alt=""
                loading="lazy"
                decoding="async"
                class="icon-news"
              />
              <div class="div-block-10">
                <h2 class="h2">Schedule a free consultation call Today!</h2>
                <div>
                  Take the first step towards stress-free accounting! Schedule your free 30-minute
                  consultation call now and get tailored advice for your small business.
                </div>
              </div>
            </div>
            <div>
              <a href="/contact-us" class="button padding w-button">Book A Consultation</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
